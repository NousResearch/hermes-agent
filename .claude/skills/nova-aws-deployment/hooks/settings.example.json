{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/command_guard.py" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(~/.aws/credentials)",
      "Read(**/.env)",
      "Read(**/*.tfstate)"
    ]
  }
}
