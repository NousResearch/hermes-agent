{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": ".venv/bin/python .specify/events.py post_tool --surface codex",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": ".venv/bin/python .specify/events.py pre_tool --surface codex",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": ".venv/bin/python .specify/events.py session_start --surface codex",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": ".venv/bin/python .specify/events.py stop --surface codex",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": ".venv/bin/python .specify/events.py user_prompt --surface codex",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
