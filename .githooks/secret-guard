#!/bin/sh
# secret-guard — block .env (and other secret files) from entering git.
#
# THE RULE: never commit or push a real .env. Only *.example / *.sample env
# files are allowed. Enforced by .githooks/pre-commit and .githooks/pre-push.
#
# Usage:
#   secret-guard --staged            check what is staged for commit (pre-commit)
#   secret-guard --tree   <ref>      check every file in <ref>'s tree (pre-push)
#   secret-guard --range  <a>..<b>   check files touched between two commits
#   secret-guard --worktree          check tracked + untracked files on disk (manual)
#
# Exit 0 = clean, 1 = a forbidden file was found, 2 = bad invocation.
# Bypass in a genuine emergency: `git commit --no-verify` / `git push --no-verify`
# (this defeats the rule — don't).

set -u

# --- the matcher --------------------------------------------------------------
# Forbidden basenames (real credential material — never belongs in git):
#   * `.env` family:  .env  .env.<anything>  .op.env
#   * OpenSSH private keys:  id_rsa  id_dsa  id_ecdsa  id_ed25519  (the .pub is fine)
#   * PKCS#12 / keystores:  *.p12  *.pfx  *.pkcs12  *.jks  *.keystore
#   * cloud / service creds:  credentials.json  service-account*.json
#                             *-service-account.json  gcloud-service-key*.json
#   * misc auth stores:  .netrc  _netrc  .pgpass  .htpasswd
#   * PEM / .key private keys  — EXCEPT public CA/cert bundles, and EXCEPT files
#     under a test/fixture path (throwaway certs by convention; see FIXTURE_OK).
#
# Always allowed: *.example / *.sample / *.template, *.pub, `.envrc` (direnv).
#
# A confirmed-safe file that still trips a rule: add its exact repo-relative path
# to ALLOWLIST below (reviewed, line-by-line — same discipline as content-scan's
# inline `nf-scan: allow`), or `--no-verify` for a one-off.

# Exact repo-relative paths that are confirmed safe despite matching a rule.
ALLOWLIST="
"

# Path fragments under which *.pem / *.key are treated as throwaway test material
# (matched against "/<repo-relative-path>", so a leading */ covers a top-level dir).
FIXTURE_OK='*/test/*|*/tests/*|*/testdata/*|*/test-data/*|*/__tests__/*|*/fixtures/*|*/__fixtures__/*|*/mocks/*|*/mock/*|*/testfixtures/*|*/e2e/*|*/spec/*'

# Public CA / certificate bundle names — not private keys, safe to commit.
PUBLIC_BUNDLE='cacert.pem|ca-bundle.pem|ca-certificates.pem|ca_bundle.pem|fullchain.pem|chain.pem|cert.pem|*-cert.pem|*-chain.pem|*-bundle.pem|*.crt.pem|*.pub.pem'

# _glob_any <string> <pipe-separated-globs>  -> 0 if any glob matches.
# `case $var in $PIPED)` does NOT treat an expanded `|` as alternation in POSIX
# sh, so split on `|` and test each glob.
_glob_any() {
    _s=$1; _oldIFS=$IFS; IFS='|'
    for _g in $2; do
        case "$_s" in $_g) IFS=$_oldIFS; return 0 ;; esac
    done
    IFS=$_oldIFS; return 1
}

is_forbidden() {
    # $1 = repo-relative path
    _p=$1
    base=${_p##*/}
    # lowercase only when there's actually an uppercase letter — avoids a `tr`
    # fork per path on a full-tree / worktree scan (thousands of files).
    case "$base" in
        *[A-Z]*) lower=$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]') ;;
        *)       lower=$base ;;
    esac

    # explicit per-path allowlist wins over every rule
    case "
$ALLOWLIST" in *"
$_p
"*) return 1 ;; esac

    # always-safe shapes
    case "$base" in
        .envrc)                             return 1 ;;
        *.example|*.sample|*.template|*.pub) return 1 ;;
    esac

    # unambiguous credential material — blocked at any depth
    case "$lower" in
        .env|.env.*|.op.env)                             return 0 ;;
        id_rsa|id_dsa|id_ecdsa|id_ed25519)              return 0 ;;
        *.p12|*.pfx|*.pkcs12|*.jks|*.keystore)          return 0 ;;
        credentials.json|serviceaccount.json|service-account.json) return 0 ;;
        *-service-account.json|service-account-*.json|gcloud-service-key*.json) return 0 ;;
        .netrc|_netrc|.pgpass|.htpasswd)                return 0 ;;
    esac

    # PEM / .key — private-key formats, but with two carve-outs
    case "$lower" in
        *.pem|*.key|*.keypair|*.priv|*.pk8)
            _glob_any "$lower" "$PUBLIC_BUNDLE" && return 1   # public CA/cert bundle
            _glob_any "/$_p"   "$FIXTURE_OK"   && return 1   # throwaway test cert
            return 0 ;;
    esac

    return 1
}

scan() {
    # reads NUL- or newline-separated paths on stdin, prints the forbidden ones
    hits=""
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        if is_forbidden "$path"; then
            hits="${hits}${path}
"
        fi
    done
    printf '%s' "$hits"
}

report() {
    # $1 = newline-separated hits, $2 = context label
    [ -n "$1" ] || return 0
    printf '\n\033[31m✖ secret-guard: refusing to %s\033[0m\n' "$2" >&2
    printf '  These paths look like real environment/secret files:\n' >&2
    printf '%s' "$1" | sed 's/^/    - /' >&2
    cat >&2 <<'EOF'

  Only *.example / *.sample env files belong in git.
  Fix: `git rm --cached <path>` (keep the file on disk), confirm it is matched
       by .gitignore, then retry. Real override: append --no-verify (defeats the rule).
EOF
    return 1
}

mode=${1:-}
case "$mode" in
    --staged)
        hits=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | scan)
        report "$hits" "commit" ;;
    --tree)
        ref=${2:?--tree needs a ref}
        hits=$(git ls-tree -r --name-only "$ref" | scan)
        report "$hits" "push (tree of ${ref})" ;;
    --range)
        rng=${2:?--range needs a..b}
        hits=$(git diff --name-only --diff-filter=ACMR "$rng" | scan)
        report "$hits" "push (range ${rng})" ;;
    --worktree)
        hits=$( { git ls-files; git ls-files --others --exclude-standard; } | scan)
        if [ -n "$hits" ]; then
            printf '%s' "$hits" | sed 's/^/  - /'
            printf 'secret-guard: %s path(s) on disk match the secret rule (see above).\n' "$(printf '%s' "$hits" | grep -c .)"
            printf 'They are fine as long as .gitignore keeps them untracked.\n'
        else
            printf 'secret-guard: clean — no .env-style files tracked or stage-able.\n'
        fi ;;
    *)
        sed -n '2,20p' "$0"; exit 2 ;;
esac
