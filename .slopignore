# Paths the anti-slop lane (lint/oxlint) never lints. gitignore syntax.
# The oxlint config lives in lint/oxlint/, and its own ignorePatterns are
# rooted there, so repo-wide ignores have to come from this root file via
# --ignore-path. Vendored, generated and third-party JS is not ours to shape.
skills/
optional-skills/
**/dist/
**/build/
**/coverage/
**/.docusaurus/
**/.vite/
*.d.ts
# The rules and the ratchet judge the tree; they are not part of it.
lint/oxlint/
