      "type": "shell",
      "command": "./scripts/install-samagent-platform.sh",
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\install-samagent-platform.ps1"
      },
      "problemMatcher": []
    },
    {
      "label": "SamAgent: Run Test Suite (13 Tests)",
      "type": "shell",
      "command": "pytest tests/samagent/test_samagent_pipeline.py -v",
      "problemMatcher": []
    }
  ]
}
