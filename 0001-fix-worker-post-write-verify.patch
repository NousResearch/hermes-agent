@@ -0,0 +1,150 @@
+"""Regression coverage for worker-visible patch persistence evidence."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools.file_operations_common import PatchResult, ReadResult
+from tools.file_tools import patch_tool
+
+
+class _PatchOps:
+    def __init__(self, *, persist: bool) -> None:
+        self.persist = persist
+
+    def read_file_raw(self, path: str) -> ReadResult:
+        target = Path(path)
+        if not target.exists():
+            return ReadResult(error="file not found", not_found=True)
+        raw = target.read_bytes()
+        return ReadResult(
+            content=raw.decode("utf-8"),
+            file_size=len(raw),
+            _content_sha256=hashlib.sha256(raw).hexdigest(),
+        )
+
+    def patch_replace(
+        self, path: str, old: str, new: str, replace_all: bool = False
+    ) -> PatchResult:
+        target = Path(path)
+        updated = target.read_text(encoding="utf-8").replace(old, new)
+        if self.persist:
+            target.write_text(updated, encoding="utf-8")
+        return PatchResult(success=True, diff=f"-{old}\n+{new}\n")
+
+
+class _RemotePatchOps:
+    env = object()
+
+    def __init__(self, path: str, *, persist: bool) -> None:
+        self.persist = persist
+        self.files = {path: "before\n"}
+        self.reads: list[str] = []
+
+    def read_file_raw(self, path: str) -> ReadResult:
+        self.reads.append(path)
+        content = self.files.get(path)
+        if content is None:
+            return ReadResult(error="file not found", not_found=True)
+        raw = content.encode("utf-8")
+        return ReadResult(
+            content=content,
+            file_size=len(raw),
+            _content_sha256=hashlib.sha256(raw).hexdigest(),
+        )
+
+    def patch_replace(
+        self, path: str, old: str, new: str, replace_all: bool = False
+    ) -> PatchResult:
+        updated = self.files[path].replace(old, new)
+        if self.persist:
+            self.files[path] = updated
+        return PatchResult(success=True, diff=f"-{old}\n+{new}\n")
+
+
+def test_worker_patch_rejects_success_when_disk_did_not_change(
+    tmp_path: Path, monkeypatch
+) -> None:
+    target = tmp_path / "worker.py"
+    target.write_text("before\n", encoding="utf-8")
+    monkeypatch.setattr("tools.file_tools._get_file_ops", lambda _task_id: _PatchOps(persist=False))
+
+    result = json.loads(
+        patch_tool(
+            path=str(target),
+            old_string="before",
+            new_string="after",
+            task_id="worker-noop",
+        )
+    )
+
+    assert result["success"] is False
+    assert "post-write verification failed" in result["error"].lower()
+    assert target.read_text(encoding="utf-8") == "before\n"
+
+
+def test_worker_patch_returns_verification_snapshot_when_disk_changed(
+    tmp_path: Path, monkeypatch
+) -> None:
+    target = tmp_path / "worker.py"
+    target.write_text("before\n", encoding="utf-8")
+    monkeypatch.setattr("tools.file_tools._get_file_ops", lambda _task_id: _PatchOps(persist=True))
+
+    result = json.loads(
+        patch_tool(
+            path=str(target),
+            old_string="before",
+            new_string="after",
+            task_id="worker-write",
+        )
+    )
+
+    assert result["success"] is True
+    assert result["verification_snapshot"]["changed_paths"] == [str(target)]
+    assert target.read_text(encoding="utf-8") == "after\n"
+
+
+def test_worker_patch_verifies_change_in_remote_backend(
+    tmp_path: Path, monkeypatch
+) -> None:
+    target = str(tmp_path / "host-absent-remote.py")
+    ops = _RemotePatchOps(target, persist=True)
+    monkeypatch.setattr("tools.file_tools._get_file_ops", lambda _task_id: ops)
+
+    result = json.loads(
+        patch_tool(
+            path=target,
+            old_string="before",
+            new_string="after",
+            task_id="worker-remote-write",
+        )
+    )
+
+    assert not Path(target).exists()
+    assert result["success"] is True
+    assert result["verification_snapshot"]["changed_paths"] == [target]
+    assert ops.reads == [target, target]
+
+
+def test_worker_patch_rejects_remote_backend_noop(
+    tmp_path: Path, monkeypatch
+) -> None:
+    target = str(tmp_path / "host-absent-remote.py")
+    ops = _RemotePatchOps(target, persist=False)
+    monkeypatch.setattr("tools.file_tools._get_file_ops", lambda _task_id: ops)
+
+    result = json.loads(
+        patch_tool(
+            path=target,
+            old_string="before",
+            new_string="after",
+            task_id="worker-remote-noop",
+        )
+    )
+
+    assert not Path(target).exists()
+    assert result["success"] is False
+    assert "post-write verification failed" in result["error"].lower()
+    assert ops.reads == [target, target]
