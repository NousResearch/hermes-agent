+        from agent.verification_evidence import classify_verification_command
+
+        evidence = classify_verification_command(
+            command,
+            cwd=cwd,
+            exit_code=returncode,
+            output=output,
+        )
+        if evidence is None or evidence.kind != "test":
+            return None
+        if returncode == 0:
+            return {"status": "ok"}
+        tail = output[-500:].strip() or f"exit code {returncode}"
+        return {"status": "failed", "error": f"failed: {tail} (exit code {returncode})"}
+    return None
