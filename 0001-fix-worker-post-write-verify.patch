@@ -0,0 +1,44 @@
+"""Regression coverage for non-zero worker test results."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+from types import SimpleNamespace
+
+from tools.terminal_tool_result import finalize_foreground_result
+
+
+def test_worker_test_exit_one_is_failed_even_when_output_says_passed(monkeypatch) -> None:
+    repo = Path(__file__).resolve().parents[2]
+    monkeypatch.setattr(
+        subprocess,
+        "run",
+        lambda *args, **kwargs: subprocess.CompletedProcess(args[0], 1, stdout="4 passed"),
+    )
+    completed = subprocess.run(["test-runner"], capture_output=True, text=True)
+    payload = json.loads(
+        finalize_foreground_result(
+            command=(
+                "scripts/run_tests.sh "
+                "tests/hermes_cli/test_worker_test_exit_honored.py -v"
+            ),
+            result={"output": completed.stdout, "returncode": completed.returncode},
+            env=SimpleNamespace(cwd=str(repo)),
+            env_type="local",
+            effective_task_id="worker-test-exit",
+            task_id="worker-test-exit",
+            session_id="worker-session",
+            session_key="worker-session",
+            workdir=None,
+            command_cwd=str(repo),
+            approval_note=None,
+        )
+    )
+
+    assert payload["exit_code"] == 1
+    assert payload["status"] == "failed"
+    assert payload["error"].startswith("failed:")
+    assert "4 passed" in payload["error"]
+    assert payload["status"] != "ok"
