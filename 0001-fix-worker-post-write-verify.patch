@@ -956,6 +957,64 @@ def _collect_v4a_header_paths(patch: str) -> tuple[list[str], list[str], list[st
     return paths, content_paths, entry_paths
 
 
+def _patch_disk_snapshot(file_ops, paths: list[str]) -> dict[str, dict[str, object]]:
+    """Return content-only persistence markers for patch targets.
+
+    The patch implementation already verifies each individual write. This
+    second, tool-boundary snapshot catches a broken or replaced implementation
+    that reports success without changing any target — the exact contract the
+    model relies on when it reports a worker edit as landed.
+    """
+    snapshot: dict[str, dict[str, object]] = {}
+    use_host_paths = _file_ops_uses_host_paths(file_ops)
+    for path in dict.fromkeys(paths):
+        if use_host_paths:
+            try:
+                raw = Path(path).read_bytes()
+            except FileNotFoundError:
+                snapshot[path] = {"exists": False}
+                continue
+            except OSError:
+                pass
+            else:
+                snapshot[path] = {
+                    "exists": True,
+                    "sha256": hashlib.sha256(raw).hexdigest(),
+                }
+                continue
+        result = file_ops.read_file_raw(path)
+        if getattr(result, "error", None):
+            snapshot[path] = (
+                {"exists": False}
+                if getattr(result, "not_found", False)
+                else {"verified": False}
+            )
+            continue
+        digest = getattr(result, "_content_sha256", None)
+        if not digest:
+            digest = hashlib.sha256(result.content.encode("utf-8")).hexdigest()
+        snapshot[path] = {"exists": True, "sha256": digest}
+    return snapshot
+
+
+def _verify_patch_changed_disk(
+    result_dict: dict, before: dict[str, dict[str, object]], after: dict[str, dict[str, object]]
+) -> None:
+    """Attach the post-write snapshot or turn an unproven success into failure."""
+    changed = sorted(path for path in before if before[path] != after.get(path))
+    result_dict["verification_snapshot"] = {
+        "method": "content_sha256",
+        "changed_paths": changed,
+        "after": after,
+    }
+    if result_dict.get("success") and not result_dict.get("no_change") and not changed:
+        result_dict["success"] = False
+        result_dict["error"] = (
+            "Post-write verification failed: patch reported success but no target "
+            "changed on disk. Nothing was recorded as written."
+        )
+
+
