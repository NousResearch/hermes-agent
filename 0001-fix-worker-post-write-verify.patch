+"""Regression coverage for worker needs-input block admission."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def worker_task(monkeypatch: pytest.MonkeyPatch, tmp_path: Path):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_PROFILE", "developer")
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+
+    def create(body: str) -> str:
+        with kbc.connect_closing() as conn:
+            task_id = kb.create_task(
+                conn,
+                title="block guard",
+                body=body,
+                assignee="developer",
+            )
+            kb.claim_task(conn, task_id)
+            task = kb.get_task(conn, task_id)
+            assert task is not None
+            run_id = task.current_run_id
+        monkeypatch.setenv("HERMES_KANBAN_TASK", task_id)
+        monkeypatch.setenv("HERMES_KANBAN_RUN_ID", str(run_id))
+        return task_id
+
+    return create
+
+
+def test_worker_cannot_block_for_acceptance_without_briefed_user_question(
+    worker_task,
+) -> None:
+    task_id = worker_task("Implement the requested change and return a working-tree diff.")
+
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    from tools import kanban_tools as kt
+
+    result = json.loads(
+        kt._handle_block(
+            {
+                "reason": "Akzeptanzpunkt muss noch bestätigt werden",
+                "kind": "needs_input",
+            }
+        )
+    )
+
+    assert "error" in result
+    assert "kanban_complete" in result["error"]
+    with kbc.connect_closing() as conn:
+        task = kb.get_task(conn, task_id)
+        assert task is not None and task.status == "running"
+
+
+def test_worker_can_block_for_question_explicitly_named_in_briefing(worker_task) -> None:
+    question = "Welche Exportvariante soll verwendet werden?"
+    task_id = worker_task(f"Frage an User: {question}")
+
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    from tools import kanban_tools as kt
+
+    result = json.loads(
+        kt._handle_block(
+            {
+                "reason": question,
+                "kind": "needs_input",
+            }
+        )
+    )
+
+    assert result["ok"] is True
+    assert result["block_kind"] == "needs_input"
+    with kbc.connect_closing() as conn:
+        task = kb.get_task(conn, task_id)
+        assert task is not None and task.status == "blocked"
