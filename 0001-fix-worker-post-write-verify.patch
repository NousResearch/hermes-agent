+def _test_run_outcome(command: str, cwd: Optional[str], returncode: int, output: str) -> Optional[dict]:
+    """Machine-readable outcome for commands classified as test runs.
+
+    Test runners can print a passing sub-summary before exiting non-zero. The
+    exit code remains authoritative; make that impossible to miss in the tool
+    result instead of asking the model to infer it from a distant JSON field.
+    """
