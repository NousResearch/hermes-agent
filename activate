#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Rabbit dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `rabbit` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-rabbit-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `rabbit pm
# install` and `rabbit update` keep that check.
# ============================================================================
_RABBIT_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_rabbit_test_env="--test-environment"
_rabbit_expect_extras=""
for _rabbit_arg in "$@"; do
    if [ -n "$_rabbit_expect_extras" ]; then
        _rabbit_test_env="--test-environment=$_rabbit_arg"
        _rabbit_expect_extras=""
        continue
    fi
    case "$_rabbit_arg" in
        --) break ;;
        --test-extras) _rabbit_expect_extras=1 ;;
        --test-extras=*) _rabbit_test_env="--test-environment=${_rabbit_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_rabbit_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _rabbit_arg _rabbit_test_env _rabbit_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _rabbit_arg _rabbit_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_RABBIT_REPO/scripts/_activation.sh"

if ! rabbit_sync "$_RABBIT_REPO" "$_rabbit_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _rabbit_test_env
    return 1 2>/dev/null || exit 1
fi
unset _rabbit_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __RABBIT_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_rabbit_script="$(rabbit_compose_env "$_RABBIT_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _rabbit_script
    return 1 2>/dev/null || exit 1
}
_rabbit_keys="$(printf '%s\n' "$_rabbit_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __RABBIT_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__RABBIT_SAVED_PATH="$PATH"
for _rabbit_k in $_rabbit_keys; do
    eval "__RABBIT_SAVED_$_rabbit_k=\"\${$_rabbit_k+set}\""
    eval "__RABBIT_PRIOR_$_rabbit_k=\${$_rabbit_k-__RABBIT_UNSET__}"
done
rabbit_apply_env "$_rabbit_script"

# This checkout, not whichever `rabbit` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__RABBIT_WORKTREE="$_RABBIT_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__RABBIT_WORKTREE_NAME="$(git -C "$_RABBIT_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__RABBIT_WORKTREE_NAME" ] || [ "$__RABBIT_WORKTREE_NAME" = HEAD ]; then
    __RABBIT_WORKTREE_NAME="$(basename "$_RABBIT_REPO")"
fi
__RABBIT_SAVED_PS1="${PS1-__RABBIT_UNSET__}"
__RABBIT_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__RABBIT_UNSET__}"

_rabbit_worktree_here() {
    _rabbit_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_rabbit_top" && pwd -P)" = "$(cd "$__RABBIT_WORKTREE" && pwd -P)" ]
}

rabbit() {
    _rabbit_worktree_here || {
        printf '%s\n' "rabbit: $(pwd) is outside $__RABBIT_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__RABBIT_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" rabbit "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe rabbit "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python rabbit "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe rabbit "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python rabbit "$@"
        else
            exec python rabbit "$@"
        fi
    )
}

_rabbit_prompt() {
    if [ "$__RABBIT_SAVED_PS1" = "__RABBIT_UNSET__" ]; then
        _rabbit_base_ps1=""
    else
        _rabbit_base_ps1="$__RABBIT_SAVED_PS1"
    fi
    if _rabbit_worktree_here; then
        PS1="($__RABBIT_WORKTREE_NAME) $_rabbit_base_ps1"
    else
        PS1="$_rabbit_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_rabbit_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_rabbit_prompt
fi
_rabbit_prompt

deactivate() {
    export PATH="$__RABBIT_SAVED_PATH"
    for _rabbit_k in $__RABBIT_KEY_LIST; do
        eval "_rabbit_was=\"\$__RABBIT_SAVED_$_rabbit_k\""
        eval "_rabbit_old=\"\$__RABBIT_PRIOR_$_rabbit_k\""
        if [ "$_rabbit_was" != "set" ]; then
            unset "$_rabbit_k"
        else
            export "$_rabbit_k=$_rabbit_old"
        fi
        unset "__RABBIT_SAVED_$_rabbit_k" "__RABBIT_PRIOR_$_rabbit_k"
    done
    if [ "$__RABBIT_SAVED_PS1" = "__RABBIT_UNSET__" ]; then
        unset PS1
    else
        PS1="$__RABBIT_SAVED_PS1"
    fi
    if [ "$__RABBIT_SAVED_PROMPT_COMMAND" = "__RABBIT_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__RABBIT_SAVED_PROMPT_COMMAND"
    fi
    unset __RABBIT_SAVED_PATH __RABBIT_KEY_LIST __RABBIT_ACTIVATED \
          __RABBIT_WORKTREE __RABBIT_WORKTREE_NAME \
          __RABBIT_SAVED_PS1 __RABBIT_SAVED_PROMPT_COMMAND
    unset -f deactivate rabbit _rabbit_worktree_here _rabbit_prompt
    unset _rabbit_k _rabbit_was _rabbit_old _rabbit_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__RABBIT_KEY_LIST="$_rabbit_keys"

# The composition library is not part of the user's shell.
unset -f rabbit_sync rabbit_bootstrap_python rabbit_compose_env rabbit_apply_env \
         rabbit_activation_current rabbit_ensure_env
unset _RABBIT_REPO _rabbit_script _rabbit_keys _rabbit_k _rabbit_top
