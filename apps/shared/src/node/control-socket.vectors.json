{
  "format": 1,
  "description": "Public local control-socket contract (protocol 1): one JSON line in, one line out. Run by tests/gateway/test_control_socket_vectors.py; documented in website/docs/developer-guide/gateway-internals.md (Local control socket).",
  "placeholders": {
    "$HOME": "a standalone profile home (resolved absolute path)",
    "$ROOT": "a multiplexer's default root",
    "$SEC": "$ROOT/profiles/work, a named profile under $ROOT",
    "$FOREIGN": "a home outside the answering gateway's root",
    "$INSTANCE": "the answering gateway's instance_id",
    "$OTHER_INSTANCE": "any other instance_id",
    "$BOOT_SHA": "the commit the answering gateway booted from (its identify code_sha)",
    "$TICKET": "in a reply: any non-empty string of at most 256 characters",
    "$INSTALL_SHA": "in a reply: a commit string or null",
    "$VERBS": "in a reply: a list of verb names"
  },
  "fields": {
    "server": "home, instance_id and profile_ids build the ticket store; peer is same-user or none; identify is the descriptor the gateway's identify verb answers with; update_marker places a fresh update fence in home; without_verbs removes verbs the gateway predates",
    "request": "the request object, sent as one JSON line",
    "request_raw": "a raw request line instead of request",
    "reply": "the reply object; error_prefix matches the start of a non-deterministic error",
    "client": "builds_request: the arguments a client builder turns into request; outcome: grant | endpoint | not_attachable | legacy | refused:<error>"
  },
  "vectors": [
    {"name": "ticket: public interactive grant",
     "server": {"home": "$HOME", "instance_id": "$INSTANCE", "profile_ids": ["$HOME"], "peer": "same-user"},
     "request": {"protocol": 1, "id": 1, "verb": "session-ticket", "params": {"profile_id": "$HOME", "instance_id": "$INSTANCE", "purpose": "interactive"}},
     "reply": {"ok": true, "protocol": 1, "id": 1, "result": {"ticket": "$TICKET", "expires_in_seconds": 30, "instance_id": "$INSTANCE", "profile_id": "$HOME", "runtime_protocol": 1}},
     "client": {"builds_request": {"verb": "session-ticket", "profile_id": "$HOME", "instance_id": "$INSTANCE"}, "outcome": "grant"}},
    {"name": "ticket: a machine poller refuses the restart wait",
     "server": {"home": "$HOME", "instance_id": "$INSTANCE", "profile_ids": ["$HOME"], "peer": "same-user"},
     "request": {"protocol": 1, "id": 1, "verb": "session-ticket", "params": {"profile_id": "$HOME", "instance_id": "$INSTANCE", "purpose": "interactive", "restart_wait": "refuse"}},
     "reply": {"ok": true, "protocol": 1, "id": 1, "result": {"ticket": "$TICKET", "expires_in_seconds": 30, "instance_id": "$INSTANCE", "profile_id": "$HOME", "runtime_protocol": 1}},
     "client": {"builds_request": {"verb": "session-ticket", "profile_id": "$HOME", "instance_id": "$INSTANCE", "refuse_restart_wait": true}, "outcome": "grant"}},
    {"name": "ticket: a served secondary is minted on the multiplexer's socket",
     "server": {"home": "$ROOT", "instance_id": "$INSTANCE", "profile_ids": ["$ROOT", "$SEC"], "peer": "same-user"},
     "request": {"protocol": 1, "id": 1, "verb": "session-ticket", "params": {"profile_id": "$SEC", "instance_id": "$INSTANCE", "purpose": "interactive"}},
     "reply": {"ok": true, "protocol": 1, "id": 1, "result": {"ticket": "$TICKET", "expires_in_seconds": 30, "instance_id": "$INSTANCE", "profile_id": "$SEC", "runtime_protocol": 1}},
     "client": {"builds_request": {"verb": "session-ticket", "profile_id": "$SEC", "instance_id": "$INSTANCE"}, "outcome": "grant"}},
    {"name": "ticket: an unverified peer gets nothing",
     "server": {"home": "$HOME", "instance_id": "$INSTANCE", "profile_ids": ["$HOME"], "peer": "none"},
     "request": {"protocol": 1, "id": 1, "verb": "session-ticket", "params": {"profile_id": "$HOME", "instance_id": "$INSTANCE", "purpose": "interactive"}},
     "reply": {"ok": false, "error": "PermissionError: authenticated runtime bootstrap unavailable", "protocol": 1, "id": 1},
     "client": {"outcome": "refused:PermissionError: authenticated runtime bootstrap unavailable"}},
    {"name": "ticket: an extra top-level key is a bad envelope",
