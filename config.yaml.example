  max_recording_seconds: 120
  auto_tts: false
  beep_enabled: true
  silence_threshold: 200
  silence_duration: 3
human_delay:
  mode: false
  min_ms: 800
  max_ms: 2500
context:
  engine: compressor
memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200
  user_char_limit: 2600
  provider: mnemosyne
  flush_min_turns: 6
  mnemosyne:
    auto_sleep: false
    sleep_threshold: 50
    vector_type: int8
  nudge_interval: 10
delegation:
  model: deepseek-v4-flash
  provider: ollama-cloud
  base_url: ''
  api_key: ''
  api_mode: ''
  inherit_mcp_toolsets: true
  max_iterations: 50
  child_timeout_seconds: 900
  reasoning_effort: medium
  max_concurrent_children: 3
  max_spawn_depth: 2
  orchestrator_enabled: true
  subagent_auto_approve: false
prefill_messages_file: ''
goals:
  max_turns: 20
skills:
  external_dirs: []
  template_vars: true
  inline_shell: false
  inline_shell_timeout: 10
  guard_agent_created: false
  creation_nudge_interval: 15
  disabled: []
curator:
  enabled: true
  interval_hours: 168
  min_idle_hours: 2
  stale_after_days: 30
  archive_after_days: 90
  backup:
    enabled: true
    keep: 5
  auxiliary:
    model:
    provider:
honcho: {}
timezone: Europe/London
