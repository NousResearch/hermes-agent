known_plugin_toolsets:
  cli:
    - spotify
mcp_servers:
  gitnexus:
    args:
      - mcp
    command: /home/kensei/.hermes/node/bin/gitnexus
    enabled: true
    prompts: false
    resources: false
    shared: true
  google_workspace:
    args:
      - workspace-mcp
      - --single-user
    command: uvx
    enabled: true
    env:
      GOOGLE_OAUTH_CLIENT_ID: 
        "REDACTED"
      GOOGLE_OAUTH_CLIENT_SECRET: "REDACTED"
      OAUTHLIB_INSECURE_TRANSPORT: '1'
    prompts: false
    resources: false
    shared: true
    tools:
      include:
        - search_gmail_messages
        - get_gmail_messages_content_batch
        - start_google_auth
        - list_calendars
        - get_events
        - query_freebusy
  github:
    command: /home/kensei/.local/bin/node
    args:
      - /home/kensei/.hermes/node/lib/node_modules/@modelcontextprotocol/server-github/dist/index.js
    env:
      GITHUB_PERSONAL_ACCESS_TOKEN: "REDACTED"
    enabled: true
    prompts: false
    resources: false
    shared: true
  mailbox_cleaner:
    args:
      - /home/kensei/.hermes/scripts/mailbox_cleaner_mcp.py
    command: /home/kensei/repos/KenseiAgent/.venv/bin/python3
    enabled: true
    prompts: false
    resources: false
    shared: true
  nanobanana:
    args:
      - /home/kensei/.hermes/node-mcps/node_modules/@ycse/nanobanana-mcp/dist/index.js
    command: /home/kensei/.local/bin/node
    enabled: false
    env:
      GOOGLE_AI_API_KEY: "REDACTED"
    shared: true
  outlook:
    args:
      - /home/kensei/.hermes/node/bin/ms-365-mcp-server
      - --preset
      - mail,calendar
    command: /home/kensei/.local/bin/node
    enabled: true
    env:
      MS365_MCP_TOKEN_CACHE_PATH: 
        /home/kensei/.config/ms-365-mcp-server/token-cache.json
    prompts: false
    resources: false
    shared: true
platform_toolsets:
  cli:
    - browser
    - clarify
    - code_execution
    - cronjob
    - delegation
    - file
    - kanban
    - memory
    - messaging
    - session_search
    - skills
    - terminal
    - web
  discord:
    - hermes-discord
  homeassistant:
    - hermes-homeassistant
  qqbot:
    - hermes-qqbot
  signal:
    - hermes-signal
  slack:
    - hermes-slack
  whatsapp:
    - hermes-whatsapp
platforms:
  webhook:
    enabled: true
    extra:
      host: 0.0.0.0
      port: 8644
      secret: "REDACTED"
plugins:
  disabled: []
  enabled:
    - disk-cleanup
    - prompt-optimizer
    - kenseivoice
  entries:
    prompt-optimizer:
      llm:
        allow_model_override: true
        allow_provider_override: true
        allowed_models:
          - deepseek-v4-flash
        allowed_providers:
          - nous
session_reset:
  at_hour: 4
  idle_minutes: 120
  mode: both
streaming:
  buffer_threshold: 20
  edit_interval: 0.8
  enabled: true
workspace:
  conductor_default_orchestrator_model: deepseek-v4-flash
  conductor_default_orchestrator_provider: ollama-cloud
  conductor_default_worker_model: kimi-k2.6
  conductor_default_worker_provider: ollama-cloud
  conductor_max_parallel_workers: 3
  conductor_preferred_worker_models:
    - model: kimi-k2.6
      provider: ollama-cloud
      use: primary general worker
    - model: deepseek-v4-flash
      provider: ollama-cloud
      use: fast coding worker
    - model: kimi-k2.6
      provider: ollama-cloud
      use: heavy coding/extraction worker
    - model: glm-5.1
      provider: ollama-cloud
      use: planning and review worker
  conductor_projects_dir: /tmp/scaffold
  operations_default_worker_model: kimi-k2.6
  operations_default_worker_provider: ollama-cloud

# ── Fallback Model ────────────────────────────────────────────────────
# Automatic provider failover when primary is unavailable.
# Uncomment and configure to enable. Triggers on rate limits (429),
# overload (529), service errors (503), or connection failures.
#
# Supported providers:
#   openrouter   (OPENROUTER_API_KEY)  — routes to any model
#   openai-codex (OAuth — hermes auth) — OpenAI Codex
#   nous         (OAuth — hermes auth) — Nous Portal
#   zai          (ZAI_API_KEY)         — Z.AI / GLM
#   kimi-coding  (KIMI_API_KEY)        — Kimi / Moonshot
#   kimi-coding-cn (KIMI_CN_API_KEY)   — Kimi / Moonshot (China)
#   minimax      (MINIMAX_API_KEY)     — MiniMax
#   minimax-cn   (MINIMAX_CN_API_KEY)  — MiniMax (China)
#   bedrock      (AWS IAM / boto3)     — AWS Bedrock (Converse API)
#
# For custom OpenAI-compatible endpoints, add base_url and key_env.
#
# fallback_model:
#   provider: openrouter
#   model: anthropic/claude-sonnet-4
