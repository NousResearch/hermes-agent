# Hermes VIP — daemon config (generated by install.sh)
# trusted_user: the Hermes user whose UID may connect to request.sock /
# control.sock. The daemon rejects any SO_PEERCRED uid not in
# {0, trusted_user} — without this the plugin cannot connect.
daemon:
  log_level: info
  audit_log: /var/log/hermes-vip/audit.log
trusted_user: __TRUSTED_USER__

sockets:
  request: /var/run/hermes-vip/request.sock
  control: /var/run/hermes-vip/control.sock

approval:
  ttl_seconds: 300

executor:
  timeout: 300
  max_stdout_bytes: 50000
