#!/bin/bash
# NOVA runtime bootstrap. Deliberately short: everything that can be decided ahead of time
# belongs in the image, not in a script that runs once on a host nobody will read again.
set -euo pipefail

STATE_DEVICE="${state_device}"
STATE_MOUNT="${state_mount}"

dnf install -y docker
systemctl enable --now docker

# Format only if the volume is blank. The audit log lives here; an unconditional mkfs on a
# reboot would be a data-destroying no-op the first ninety-nine times it ran.
if ! blkid "$STATE_DEVICE" >/dev/null 2>&1; then
  mkfs -t xfs "$STATE_DEVICE"
fi

mkdir -p "$STATE_MOUNT"
grep -q "$STATE_MOUNT" /etc/fstab || \
  echo "$STATE_DEVICE $STATE_MOUNT xfs defaults,nofail 0 2" >> /etc/fstab
mount -a

# The image runs as uid 10001 and a freshly formatted volume is root:root, so without this
# the first boot exits immediately with "not writable by uid 10001". Applied after the
# mount, because chowning the mountpoint before mounting changes the wrong directory.
#
# Recursive, not just the mountpoint: on a blank volume there is nothing under it and the
# two are identical, but anything an operator later copies in over SSM arrives owned by
# root, and a non-recursive chown here would leave that unreadable to the container. It
# costs nothing on an empty volume and removes a failure that only appears at step 23.
chown -R 10001:10001 "$STATE_MOUNT"

aws ecr get-login-password --region "${region}" \
  | docker login --username AWS --password-stdin "$(echo "${image_uri}" | cut -d/ -f1)"
docker pull "${image_uri}"

cat > /etc/nova.env <<ENVEOF
NOVA_TENANT_ID=${tenant_id}
NOVA_AWS_REGION=${region}
NOVA_INTEGRATION_EXTERNAL_ID=${external_id}
NOVA_INTEGRATIONS=${integrations}
ENVEOF
chmod 0640 /etc/nova.env

cat > /etc/systemd/system/nova.service <<UNITEOF
[Unit]
Description=NOVA runtime
After=docker.service local-fs.target
Requires=docker.service

[Service]
Restart=always
RestartSec=5
EnvironmentFile=/etc/nova.env
ExecStartPre=-/usr/bin/docker rm -f nova
ExecStart=/usr/bin/docker run --rm --name nova \
  --env-file /etc/nova.env \
  --network host \
  --volume ${state_mount}:/var/lib/nova \
  --log-driver awslogs \
  --log-opt awslogs-region=${region} \
  --log-opt awslogs-group=${log_group} \
  ${image_uri}

[Install]
WantedBy=multi-user.target
UNITEOF

# The other half. The control plane above governs and observes; it holds neither the
# runtime's dependencies nor a model credential, so it cannot run an agent — the
# dispatcher claims `ready` tasks and shells out to `hermes -p <assignee> chat -q`, which
# needs the full runtime image. Without this unit the Control Center creates durable
# tasks that nothing ever claims, which is exactly how the first real workload test
# failed.
#
# Same state volume, same home, so both processes see one board. HERMES_UID makes the
# runtime image (whose own user is uid 10000) run as 10001, the owner this script chowned
# the volume to; the image's stage2 hook does the remap. No model credential is placed
# here or in the tenant bundle: an agent reaches Bedrock through the instance role, which
# iam.tf already scopes to the declared models.
#
# **The container runs no command.** The runtime image supervises its own gateway: the
# boot reconciler (`hermes_cli/container_boot.reconcile_profile_gateways`) registers an s6
# slot named `gateway-default`, and s6 runs `hermes gateway run --replace` inside it. The
# embedded kanban dispatcher lives in that gateway
# (`gateway/kanban_watchers.py::_kanban_dispatcher_watcher`, gated on
# `kanban.dispatch_in_gateway`, default true), so supervising the gateway is all that is
# needed to execute work.
#
# Passing `gateway run` as the container command starts a SECOND one. `main-wrapper.sh`
# routes any non-executable first argument to `hermes <args>`, and
# `container_boot._is_legacy_gateway_run_request` separately treats that exact argv as a
# pre-s6 container and seeds `gateway_state.json` so the s6 slot starts too. Both then race
# for the PID file in `gateway/run.py::_start_gateway_claim_pid_file`; the loser logs
# "Exiting to avoid double-running" and exits. When the loser is the container's main
# program, the container exits with it, systemd restarts it, and the gateway never survives
# long enough to reach `_start_spawn_background_watchers()` — which is the LAST thing
# `start()` does, and the only place the dispatcher watcher is spawned.
#
# `sleep infinity` is the image's documented "just supervise" form: `main-wrapper.sh` execs
# a first argument that is a real executable, so the main program is a process that does
# nothing and never exits, and s6 restarts a failing gateway in place instead of taking the
# container down with it.
#
# HERMES_GATEWAY_BOOTSTRAP_STATE=running is how the slot comes UP on a blank volume. Without
# it the reconciler registers the slot DOWN and waits for someone to start it, because a
# gateway an operator deliberately stopped must stay stopped across restarts. Declaring the
# intent here is also what lets us stop relying on the legacy-argv compatibility path above.
if [ -n "${worker_image_uri}" ]; then
  docker pull "${worker_image_uri}"

  cat > /etc/systemd/system/nova-worker.service <<WORKEREOF
[Unit]
Description=NOVA work dispatcher (Hermes runtime)
After=docker.service local-fs.target nova.service
Requires=docker.service

[Service]
Restart=always
RestartSec=5
EnvironmentFile=/etc/nova.env
ExecStartPre=-/usr/bin/docker rm -f nova-worker
ExecStart=/usr/bin/docker run --rm --name nova-worker \
  --env-file /etc/nova.env \
  --env HERMES_HOME=${state_mount}/home \
  --env HERMES_UID=10001 \
  --env HERMES_GATEWAY_BOOTSTRAP_STATE=running \
  --env AWS_REGION=${region} \
  --network host \
  --volume ${state_mount}:${state_mount} \
  --log-driver awslogs \
  --log-opt awslogs-region=${region} \
  --log-opt awslogs-group=${log_group} \
  ${worker_image_uri} sleep infinity

[Install]
WantedBy=multi-user.target
WORKEREOF
fi

systemctl daemon-reload
systemctl enable --now nova.service

# An `if`, not `[ -f ... ] && ...`: under `set -e` a false test as the script's last
# command exits 1, and cloud-init would report the whole bootstrap as failed on every
# control-plane-only deployment.
if [ -f /etc/systemd/system/nova-worker.service ]; then
  systemctl enable --now nova-worker.service
fi
