# ~/.hermes/profiles/educator/.env — the educator's OWN credentials.
# Never copy values from the default profile's .env. Under
# gateway.multiplex_profiles every tool reads these through the profile's
# secret scope; nothing here reaches the default bot, and nothing of the
# default bot's reaches this one. chmod 600.
#
# Names only: fill values on the VM, keep them in the password manager.

# ── Slack: the educator's own Slack app (slack-app-manifest.yaml) ─────────
SLACK_BOT_TOKEN=            # xoxb-… (OAuth & Permissions → Bot User OAuth Token)
SLACK_APP_TOKEN=            # xapp-… (Basic Information → App-Level Tokens, scope connections:write)

# ── Model provider ───────────────────────────────────────────────────────
# The key for config.yaml model.provider. Same provider as the default bot
# is fine; a separate key makes its spend visible in the provider's console.
OPENAI_API_KEY=

# ── Notion: its own internal integration ─────────────────────────────────
# Shared ONLY with: Releases, Release Assets, Detailed Bucket Features, the
# Ideas database, and its home page (ROLLOUT.md step 2).
NOTION_API_KEY=             # ntn_… / secret_…
NOTION_KEYRING=0            # ntn CLI: read the key from env, no OS keyring (headless)

# ── Jira: read-only ──────────────────────────────────────────────────────
# A bot user with Browse Projects on BA and EV only (no write permissions).
JIRA_BASE_URL=              # https://everafterai.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── Zendesk: confidential OAuth client, client-credentials grant ─────────
# Allowed scopes pinned to exactly "hc:read hc:write". API tokens are not
# used (Zendesk is retiring them). See ROLLOUT.md step 2 "Zendesk".
ZENDESK_SUBDOMAIN=          # everafterai
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=

# ── GitHub: fine-grained token ───────────────────────────────────────────
# Repository access: everafterai/product-skills (Contents + Pull requests:
# read/write) and everafterai/ea-monorepo (Contents + Pull requests: read).
# Add Checks + Commit statuses: read for pr_status. Also used by the
# release-watch script to fetch both read-only checkouts.
GITHUB_PR_TOKEN=

# ── Web search (optional) ────────────────────────────────────────────────
# Without one, web_search uses a keyless free tier where available. Set the
# same backend the default bot uses if research quality needs it.
# EXA_API_KEY=
# PARALLEL_API_KEY=
# FIRECRAWL_API_KEY=
