#cloud-config
# litco-agent matter host: first-boot cloud-init (DigitalOcean user_data).
#
# Rendered per matter by deploy/host/render-user-data.py from a JSON spec the
# LitKit control plane supplies, and passed as user_data when it creates a
# droplet from a litco-agent-host-<version> snapshot. The snapshot is
# secret-free; this is the only way secrets reach the host.
#
# Secrets land in exactly two files, both root-owned and 0600:
#   /etc/litco-agent/env              read by systemd for the unit's
#                                     EnvironmentFile= (the hermes user cannot read it)
#   /etc/litco-agent/tailscale-authkey  consumed by `tailscale up`, then shredded
# Everything else below is non-secret.
#
# Security model: like the LitKit worker fleet, secrets ride in user_data, which
# the DigitalOcean metadata API serves to processes on this droplet for its
# lifetime. The droplet is single-matter, and the agent on it already holds the
# same secrets in its environment.
#
# Marker comment lines of the form NAME_BEGIN / NAME_END in double braces bound
# optional blocks (TAILSCALE, EGRESS_ALLOWLIST). The
# renderer drops a whole block (markers included) when it does not apply and
# drops only the marker lines when it does.

hostname: {{HOSTNAME}}
preserve_hostname: false

write_files:
  - path: /etc/litco-agent/env
    owner: root:root
    permissions: "0600"
    encoding: b64
    content: {{ENV_B64}}
  - path: /etc/litco-agent/matter.json
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: {{MATTER_JSON_B64}}
# {{TAILSCALE_BEGIN}}
  - path: /etc/litco-agent/tailscale-authkey
    owner: root:root
    permissions: "0600"
    encoding: b64
    content: {{TAILSCALE_AUTHKEY_B64}}
# {{TAILSCALE_END}}

runcmd:
  # 1. Hostname matter-<shortid>, so the tailnet name and the journal say which matter this is.
  - hostnamectl set-hostname "{{HOSTNAME}}"
  # 2. Re-assert the env file's ownership and mode.
  - chown root:root /etc/litco-agent/env
  - chmod 600 /etc/litco-agent/env
  # 3. The matter home (LITCO_MATTER_HOME), owned by the service user.
  - install -d -o hermes -g hermes -m 0750 "{{MATTER_HOME}}"
# {{TAILSCALE_BEGIN}}
  # 4. Join the tailnet with SSH, then destroy the one-time key file.
  - tailscale up --ssh --hostname="{{HOSTNAME}}" --auth-key=file:/etc/litco-agent/tailscale-authkey
  - shred -u /etc/litco-agent/tailscale-authkey
# {{TAILSCALE_END}}
  # 5. Firewall: nothing inbound except over the tailnet; outbound open by default.
  - ufw --force reset
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow in on tailscale0
# {{EGRESS_ALLOWLIST_BEGIN}}
  # 5a. egressPolicy=allowlist: outbound limited to the tailnet, DNS, NTP,
  #     Tailscale's direct UDP port, and the destinations in the spec.
  - ufw allow out on tailscale0
  - ufw allow out 53
  - ufw allow out 123/udp
  - ufw allow out 41641/udp
{{EGRESS_ALLOWLIST_RULES}}
  - ufw default deny outgoing
# {{EGRESS_ALLOWLIST_END}}
  - ufw --force enable
  # 6. Start the agent. RESTART, not start: the image bakes the unit enabled,
  #    and the unit's ConditionPathExists only now holds.
  - systemctl daemon-reload
  - systemctl restart litco-agent.service
  - systemctl status --no-pager litco-agent.service || true
