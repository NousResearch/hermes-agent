DEFAULT_ENV_FILE = "/etc/litco-supervisor.env"
UNIT_TEMPLATE = "litco-agent@{id}.service"
USER_PREFIX = "m_"
# Slot users get uids apart from the image's hermes user (10000) and from people.
SLOT_UID_MIN, SLOT_UID_MAX = 20000, 29999
MAX_BODY = 64 * 1024
COMMAND_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Kept in step with render-user-data.py (a test checks the two agree): Hermes
# reads each provider's key from its own variable, and "custom" reads the
# variable named by LITCO_MODEL_KEY_ENV.
PROVIDER_KEY_ENV = {
    "anthropic": "ANTHROPIC_API_KEY",
    "openrouter": "OPENROUTER_API_KEY",
    "gemini": "GEMINI_API_KEY",
    "nous-api": "NOUS_API_KEY",
    "zai": "GLM_API_KEY",
    "deepinfra": "DEEPINFRA_API_KEY",
    "nvidia": "NVIDIA_API_KEY",
    "huggingface": "HF_TOKEN",
    "custom": "LITCO_MODEL_API_KEY",
}
# The TypeSafe key for litkit_jev (Jev first-pass screen), as render-user-data.py writes it.
TYPESAFE_KEY_ENV = "TYPESAFE_API_KEY"
CHANNEL_ENV_KEYS = (
    "SLACK_BOT_TOKEN", "SLACK_APP_TOKEN", "SLACK_ALLOWED_USERS", "SLACK_HOME_CHANNEL",
    "SLACK_IGNORED_CHANNELS", "TELEGRAM_BOT_TOKEN", "TELEGRAM_ALLOWED_USERS",
    "TELEGRAM_GROUP_ALLOWED_USERS", "TELEGRAM_GROUP_ALLOWED_CHATS",
)
APPROVAL_MODES = ("", "manual", "smart", "off")
BODY_KEYS = frozenset({
    "matterId", "instanceUrl", "hostSecret", "agentToken", "modelProvider", "model",
    "modelBaseUrl", "modelKey", "typesafeApiKey", "approvalsMode", "channelEnv",
})

SLOT_ID = re.compile(r"^[a-z0-9]{1,30}$")
_MATTER_ID = re.compile(r"^[A-Za-z0-9_-]{1,128}$")
_URL = re.compile(r"^https?://[A-Za-z0-9.-]+(:\d+)?(/[A-Za-z0-9._/-]*)?$")
_PROVIDER = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
_PLAIN = re.compile(r"^[A-Za-z0-9._:/@+-]*$")
_ENV_KEY = re.compile(r"^[A-Z_][A-Z0-9_]*$")

# The unit's view of itself: systemctl is-active output -> slot state.
_ACTIVE_STATE = {
    "active": "running", "reloading": "running", "activating": "starting",
    "deactivating": "stopping", "inactive": "stopped", "failed": "failed",
}


class SupervisorError(Exception):
    """An API error: an HTTP status, a stable code, and a message with no secret in it."""

    def __init__(self, status: int, code: str, message: str):
        super().__init__(message)
        self.status, self.code, self.message = status, code, message


class ConfigError(Exception):
    pass


# ── configuration ───────────────────────────────────────────────────────────

@dataclass
class Config:
    secret: str
    bind: str = "0.0.0.0"
    port: int = 8700
    interface: str = "tailscale0"   # empty: no device binding (container smoke)
    state_dir: Path = Path("/var/lib/litco-supervisor")
    run_dir: Path = Path("/run/litco-agent")
    home_root: Path = Path("/srv/litco/m")
    base_port: int = 8800
    max_slots: int = 64
    ref_file: Path = Path("/opt/litco-agent/REF")

    @property
    def state_path(self) -> Path:
        return self.state_dir / "slots.json"


def parse_env_file(text: str) -> dict:
    """KEY=VALUE lines as systemd's EnvironmentFile= reads them (quotes optional)."""
    values = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith(("#", ";")):
            continue
        key, sep, value = line.partition("=")
        key = key.strip()
        if not sep or not _ENV_KEY.match(key):
            raise ConfigError(f"not a KEY=VALUE line in the env file (key {key[:40]!r})")
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] == '"':
            value = re.sub(r"\\(.)", r"\1", value[1:-1])
        elif len(value) >= 2 and value[0] == value[-1] == "'":
            value = value[1:-1]
        values[key] = value
    return values


def load_config(env_file: Path, environ=None) -> Config:
    """Read the machine's supervisor env file. Non-secret keys may be overridden by environ."""
    try:
        info = env_file.stat()
        text = env_file.read_text(encoding="utf-8")
    except OSError as exc:
        raise ConfigError(f"cannot read {env_file}: {exc}") from exc
    if stat.S_IMODE(info.st_mode) & 0o077:
        raise ConfigError(f"{env_file} must not be readable by group or others (chmod 600)")
    values = parse_env_file(text)
    src = os.environ if environ is None else environ
    secret = values.get("LITCO_SUPERVISOR_SECRET", "")
    if len(secret) < 32:
        raise ConfigError("LITCO_SUPERVISOR_SECRET is missing or shorter than 32 characters")

    def setting(key: str, default: str) -> str:
        return str(src.get(key) or values.get(key) or default).strip()

    try:
        config = Config(
            secret=secret,
            bind=setting("LITCO_SUPERVISOR_BIND", "0.0.0.0"),
            port=int(setting("LITCO_SUPERVISOR_PORT", "8700")),
            interface=str(src.get("LITCO_SUPERVISOR_INTERFACE",
                                  values.get("LITCO_SUPERVISOR_INTERFACE", "tailscale0"))).strip(),
            state_dir=Path(setting("LITCO_SUPERVISOR_STATE_DIR", "/var/lib/litco-supervisor")),
            run_dir=Path(setting("LITCO_SUPERVISOR_RUN_DIR", "/run/litco-agent")),
            home_root=Path(setting("LITCO_SUPERVISOR_HOME_ROOT", "/srv/litco/m")),
            base_port=int(setting("LITCO_SLOT_BASE_PORT", "8800")),
            max_slots=int(setting("LITCO_SLOT_MAX", "64")),
        )
    except ValueError as exc:
        raise ConfigError(f"a port or count setting is not a number: {exc}") from exc
    try:
        ipaddress.ip_address(config.bind)
    except ValueError as exc:
        raise ConfigError("LITCO_SUPERVISOR_BIND must be an IP address") from exc
    if not 0 < config.port < 65536 or not 0 < config.base_port < 65536 - config.max_slots:
        raise ConfigError("ports must be in 1-65535")
    if config.base_port <= config.port < config.base_port + config.max_slots:
        raise ConfigError("the supervisor port falls inside the slot port range")
    for path in (config.state_dir, config.run_dir, config.home_root):
        if not path.is_absolute():
            raise ConfigError(f"{path} must be an absolute path")
    return config


# ── running commands ────────────────────────────────────────────────────────

@dataclass
class CommandResult:
    returncode: int
    stdout: str = ""
    stderr: str = ""


Runner = Callable[[list], CommandResult]


def run_command(argv: list) -> CommandResult:
    """Run a system command with a minimal environment: no secret reaches a child."""
    env = {"PATH": COMMAND_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"}
    try:
        proc = subprocess.run(argv, env=env, capture_output=True, text=True, check=False,
                              stdin=subprocess.DEVNULL)
    except OSError as exc:
        return CommandResult(127, "", str(exc))
    return CommandResult(proc.returncode, proc.stdout, proc.stderr)


# ── the slot env file ───────────────────────────────────────────────────────

def env_line(key: str, value: str) -> str:
    """One systemd EnvironmentFile line; double quotes, with \\ and " escaped."""
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'{key}="{escaped}"'


def _str(body: dict, key: str, *, required: bool = False) -> str:
    value = body.get(key, "")
    if value is None:
        value = ""
    if not isinstance(value, str):
        raise SupervisorError(400, "invalid_body", f"{key} must be a string")
    value = value.strip()
    if required and not value:
        raise SupervisorError(400, "invalid_body", f"{key} is required")
    if any(ord(ch) < 32 or ord(ch) == 127 for ch in value):
        raise SupervisorError(400, "invalid_body", f"{key} contains control characters")
    return value


def validate_body(body) -> dict:
    """Check a PUT body. Error messages name fields and never repeat a value."""
    if not isinstance(body, dict):
        raise SupervisorError(400, "invalid_body", "body must be a JSON object")
    unknown = sorted(set(body) - BODY_KEYS)
    if unknown:
        raise SupervisorError(400, "invalid_body", f"unknown fields: {', '.join(unknown)}")
    matter_id = _str(body, "matterId", required=True)
    if not _MATTER_ID.match(matter_id):
        raise SupervisorError(400, "invalid_body", "matterId must be letters, digits, - or _")
    instance_url = _str(body, "instanceUrl", required=True)
    if not _URL.match(instance_url):
        raise SupervisorError(400, "invalid_body", "instanceUrl must be an http(s) URL")
    host_secret = _str(body, "hostSecret", required=True)
    if len(host_secret) < 32:
        raise SupervisorError(400, "invalid_body", "hostSecret must be at least 32 characters")
    agent_token = _str(body, "agentToken", required=True)
    if not agent_token.startswith("lkm_"):
        raise SupervisorError(400, "invalid_body", "agentToken must be a matter-pinned LitKit token (lkm_...)")
    provider = _str(body, "modelProvider", required=True).lower()
    if not _PROVIDER.match(provider):
        raise SupervisorError(400, "invalid_body", "modelProvider must be a Hermes provider slug")
    model = _str(body, "model")
    model_base_url = _str(body, "modelBaseUrl")
    for key, value in (("model", model), ("modelBaseUrl", model_base_url)):
        if not _PLAIN.match(value):
            raise SupervisorError(400, "invalid_body", f"{key} contains characters that cannot go into the profile")
    model_key = _str(body, "modelKey")
    if model_key and provider not in PROVIDER_KEY_ENV:
        raise SupervisorError(400, "invalid_body", f"no known key variable for provider {provider!r}")
    typesafe_key = _str(body, "typesafeApiKey")
    approvals = _str(body, "approvalsMode").lower()
    if approvals not in APPROVAL_MODES:
        raise SupervisorError(400, "invalid_body", "approvalsMode must be empty, manual, smart or off")
    channel_env = body.get("channelEnv") or {}
    if not isinstance(channel_env, dict):
        raise SupervisorError(400, "invalid_body", "channelEnv must be an object")
    bad = sorted(set(channel_env) - set(CHANNEL_ENV_KEYS))
    if bad:
        raise SupervisorError(400, "invalid_body", f"channelEnv keys not allowed: {', '.join(bad)}")
    channels = {key: _str(channel_env, key) for key in CHANNEL_ENV_KEYS if key in channel_env}
    return {
        "matter_id": matter_id, "instance_url": instance_url, "host_secret": host_secret,
        "agent_token": agent_token, "provider": provider, "model": model,
        "model_base_url": model_base_url, "model_key": model_key, "typesafe_key": typesafe_key,
        "approvals": approvals, "channels": channels,
    }


def build_env(slot_id: str, home: Path, port: int, uid: int, v: dict) -> str:
    """The slot's /run/litco-agent/<id>.env: the only place its secrets are written."""
    custom_key = v["model_key"] and v["provider"] == "custom"
    lines = [
        f"# litco-agent slot {slot_id}. Written by litco-supervisor at each start, deleted at stop.",
        "# Read by systemd for litco-agent@.service (EnvironmentFile=). root:root 0600.",
        "# -- non-secret --",
        env_line("LITCO_SLOT_ID", slot_id),
        env_line("LITCO_MATTER_ID", v["matter_id"]),
        env_line("LITCO_INSTANCE_URL", v["instance_url"]),
        env_line("LITCO_MATTER_HOME", str(home / "matter")),
        env_line("HERMES_HOME", str(home / ".hermes")),
        # The template unit cannot name the slot user's uid, and Hermes cron needs
        # the user manager's runtime dir (linger is enabled for every slot user).
        env_line("XDG_RUNTIME_DIR", f"/run/user/{uid}"),
        env_line("LITCO_TURN_HOST", "0.0.0.0"),
        env_line("LITCO_TURN_PORT", str(port)),
        env_line("LITCO_SLOT_PORT", str(port)),
        env_line("LITCO_MODEL_PROVIDER", v["provider"]),
        env_line("LITCO_MODEL", v["model"]),
        env_line("LITCO_MODEL_BASE_URL", v["model_base_url"]),
        env_line("LITCO_MODEL_KEY_ENV", PROVIDER_KEY_ENV["custom"] if custom_key else ""),
        env_line("LITCO_APPROVALS_MODE", v["approvals"]),
        "# -- secret --",
        env_line("LITCO_HOST_SECRET", v["host_secret"]),
        env_line("LITCO_AGENT_TOKEN", v["agent_token"]),
    ]
    if v["model_key"]:
        lines.append(env_line(PROVIDER_KEY_ENV[v["provider"]], v["model_key"]))
    if v["typesafe_key"]:
        lines.append(env_line(TYPESAFE_KEY_ENV, v["typesafe_key"]))
    for key, value in v["channels"].items():
        lines.append(env_line(key, value))
    return "\n".join(lines) + "\n"


def write_private(path: Path, text: str, dir_mode: int = 0o700) -> None:
    """Write a 0600 file atomically; the temp file is 0600 from creation."""
    path.parent.mkdir(mode=dir_mode, parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


# ── the supervisor ──────────────────────────────────────────────────────────

def _now() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


@dataclass
class Supervisor:
    config: Config
    runner: Runner = run_command
    log: Callable[[str], None] = field(default=lambda msg: print(f"litco-supervisor: {msg}", file=sys.stderr, flush=True))

    def __post_init__(self):
        self._lock = threading.Lock()          # guards the registry and the lock table
        self._slot_locks: dict = {}
        self._stopping: set = set()
        self._threads: list = []
        self._started = time.monotonic()
        self._slots = self._load_registry()
        self.reconcile()

    # registry ---------------------------------------------------------------

    def _load_registry(self) -> dict:
        try:
            doc = json.loads(self.config.state_path.read_text(encoding="utf-8"))
        except FileNotFoundError:
            return {}
        except (OSError, ValueError) as exc:
            raise ConfigError(f"cannot read {self.config.state_path}: {exc}") from exc
        slots = doc.get("slots") if isinstance(doc, dict) else None
        if not isinstance(slots, dict):
            raise ConfigError(f"{self.config.state_path} has no slots object")
        return slots

    def _save_registry(self) -> None:
        doc = {"version": 1, "slots": self._slots}
        write_private(self.config.state_path, json.dumps(doc, indent=2, sort_keys=True) + "\n")

    def _allocate_port(self) -> int:
        used = {rec["port"] for rec in self._slots.values()}
        for index in range(self.config.max_slots):
            port = self.config.base_port + index
            if port not in used:
                return port
        raise SupervisorError(503, "no_free_port",
                              f"all {self.config.max_slots} slot ports are assigned")

    def _slot_lock(self, slot_id: str) -> threading.Lock:
        with self._lock:
            return self._slot_locks.setdefault(slot_id, threading.Lock())

    def _update(self, slot_id: str, **changes) -> None:
        with self._lock:
            self._slots[slot_id].update(changes, updatedAt=_now())
            self._save_registry()

    # helpers ----------------------------------------------------------------

    def env_path(self, slot_id: str) -> Path:
        return self.config.run_dir / f"{slot_id}.env"

    def _run(self, argv: list, code: str) -> CommandResult:
        result = self.runner(argv)
        if result.returncode != 0:
            self.log(f"{argv[0]} {argv[1] if len(argv) > 1 else ''} exited {result.returncode}: "
                     f"{result.stderr.strip()[-300:]}")
            raise SupervisorError(500, code, f"{argv[0]} failed with exit code {result.returncode}")
        return result

    def unit_state(self, slot_id: str) -> str:
        result = self.runner(["systemctl", "is-active", UNIT_TEMPLATE.format(id=slot_id)])
        return (result.stdout.strip().splitlines() or ["unknown"])[0]

    def _state(self, slot_id: str) -> str:
        if slot_id in self._stopping:
            return "stopping"
        return _ACTIVE_STATE.get(self.unit_state(slot_id), "unknown")

    def _public(self, slot_id: str, state: str | None = None) -> dict:
        rec = self._slots[slot_id]
        return {
            "id": slot_id, "matterId": rec["matterId"], "port": rec["port"],
            "unixUser": rec["unixUser"], "state": state or self._state(slot_id),
        }

    def _delete_env(self, slot_id: str) -> None:
        self.env_path(slot_id).unlink(missing_ok=True)

    def _ensure_user(self, user: str, home: Path, matter_id: str) -> tuple:
        created = False
        if self.runner(["getent", "passwd", user]).returncode != 0:
            self._run(["useradd", "--home-dir", str(home), "--no-create-home", "--user-group",
                       "--shell", "/bin/bash", "--comment", f"litco matter {matter_id}",
                       "-K", f"UID_MIN={SLOT_UID_MIN}", "-K", f"UID_MAX={SLOT_UID_MAX}",
                       "-K", f"GID_MIN={SLOT_UID_MIN}", "-K", f"GID_MAX={SLOT_UID_MAX}", user],
                      "useradd_failed")
            created = True
        uid_text = self._run(["id", "-u", user], "user_lookup_failed").stdout.strip()
        if not uid_text.isdigit():
            raise SupervisorError(500, "user_lookup_failed", f"no numeric uid for {user}")
        # The parent is traversable but not listable; each home is its owner's alone.
        self._run(["install", "-d", "-m", "0711", "-o", "root", "-g", "root",
                   str(self.config.home_root)], "home_failed")
        self._run(["install", "-d", "-m", "0700", "-o", user, "-g", user, str(home)], "home_failed")
        self._run(["loginctl", "enable-linger", user], "linger_failed")
        return created, int(uid_text)

    # API --------------------------------------------------------------------

    def put_slot(self, slot_id: str, body) -> tuple:
        if not SLOT_ID.match(slot_id):
            raise SupervisorError(400, "invalid_slot_id", "slot id must be 1-30 lowercase letters and digits")
        v = validate_body(body)
        with self._slot_lock(slot_id):
            with self._lock:
                if slot_id in self._stopping:
                    raise SupervisorError(409, "slot_stopping", "the slot is stopping; retry once it has stopped")
                rec = self._slots.get(slot_id)
                if rec and rec["matterId"] != v["matter_id"]:
                    raise SupervisorError(409, "slot_matter_mismatch", "this slot id belongs to another matter")
                other = next((sid for sid, r in self._slots.items()
                              if r["matterId"] == v["matter_id"] and sid != slot_id), None)
                if other:
                    raise SupervisorError(409, "matter_has_slot", f"this matter already has slot {other}")
                new = rec is None
                if new:
                    home = self.config.home_root / slot_id
                    rec = {"matterId": v["matter_id"], "port": self._allocate_port(),
                           "unixUser": f"{USER_PREFIX}{slot_id}", "home": str(home),
                           "desired": "stopped", "createdAt": _now(), "updatedAt": _now()}
                    self._slots[slot_id] = rec
                    self._save_registry()
            user, home, port = rec["unixUser"], Path(rec["home"]), rec["port"]
            user_created, uid = self._ensure_user(user, home, v["matter_id"])
            unit = UNIT_TEMPLATE.format(id=slot_id)
            before = self.unit_state(slot_id)
            write_private(self.env_path(slot_id), build_env(slot_id, home, port, uid, v))
            started = False
            if before not in ("active", "activating", "reloading"):
                if before == "failed":
                    self.runner(["systemctl", "reset-failed", unit])
                try:
                    self._run(["systemctl", "start", unit], "start_failed")
                except SupervisorError:
                    self._delete_env(slot_id)
                    self._update(slot_id, desired="stopped")
                    raise
                started = True
            self._update(slot_id, desired="running")
            self.log(f"slot {slot_id} port {port}: {'started' if started else 'already running'}"
                     f"{' (user created)' if user_created else ''}")
            return 200, {
                "slot": self._public(slot_id), "created": new, "userCreated": user_created,
                "started": started,
            }

    def stop_slot(self, slot_id: str) -> tuple:
        if not SLOT_ID.match(slot_id):
            raise SupervisorError(400, "invalid_slot_id", "slot id must be 1-30 lowercase letters and digits")
        with self._lock:
            if slot_id not in self._slots:
                raise SupervisorError(404, "no_such_slot", "no slot with this id")
            if slot_id in self._stopping:
                return 202, {"slot": self._public(slot_id, "stopping")}
        with self._slot_lock(slot_id):
            state = self.unit_state(slot_id)
            if state in ("inactive", "failed"):
                self._delete_env(slot_id)
                self._update(slot_id, desired="stopped")
                return 200, {"slot": self._public(slot_id)}
            with self._lock:
                self._stopping.add(slot_id)
            self._update(slot_id, desired="stopped")
        thread = threading.Thread(target=self._stop_worker, args=(slot_id,),
                                  name=f"stop-{slot_id}", daemon=True)
        with self._lock:
            self._threads = [t for t in self._threads if t.is_alive()] + [thread]
        thread.start()
        return 202, {"slot": self._public(slot_id, "stopping")}

    def _stop_worker(self, slot_id: str) -> None:
        # The unit's ExecStop (litco-agent-drain) puts the turn server into drain
        # and waits for the slot's own turns, so this blocks as long as they run.
        try:
            result = self.runner(["systemctl", "stop", UNIT_TEMPLATE.format(id=slot_id)])
            if result.returncode != 0:
                self.log(f"slot {slot_id}: systemctl stop exited {result.returncode}: "
                         f"{result.stderr.strip()[-300:]}")
        finally:
            with self._slot_lock(slot_id):
                self._delete_env(slot_id)
                with self._lock:
                    self._stopping.discard(slot_id)
            self.log(f"slot {slot_id}: stopped; env file deleted")

    def list_slots(self) -> dict:
        with self._lock:
            ids = sorted(self._slots)
        slots = []
        for slot_id in ids:
            state = self._state(slot_id)
            if state in ("stopped", "failed"):
                self._sweep_env(slot_id)
            slots.append(self._public(slot_id, state))
        return {"slots": slots}

    def _sweep_env(self, slot_id: str) -> None:
        """Delete a stopped slot's leftover env file, e.g. after a restart mid-stop.

        Skips a slot whose lock is held: a PUT writes the env file before it
        starts the unit, so the unit is briefly inactive with its file present.
        """
        lock = self._slot_lock(slot_id)
        if not lock.acquire(blocking=False):
            return
        try:
            if (self._slots[slot_id].get("desired") == "stopped" and slot_id not in self._stopping
                    and self.env_path(slot_id).exists()):
                self._delete_env(slot_id)
                self.log(f"slot {slot_id}: not running; stale env file deleted")
        finally:
            lock.release()

    def health(self) -> dict:
        try:
            ref = self.config.ref_file.read_text(encoding="utf-8").strip()
        except OSError:
            ref = None
        return {"ok": True, "service": "litco-supervisor", "ref": ref,
                "uptimeSeconds": int(time.monotonic() - self._started)}

    def reconcile(self) -> None:
        """After a restart or a reboot: a slot not running holds no env file."""
        for slot_id in sorted(self._slots):
            state = self.unit_state(slot_id)
            if state in ("inactive", "failed"):
                if self.env_path(slot_id).exists():
                    self._delete_env(slot_id)
                    self.log(f"slot {slot_id}: not running; stale env file deleted")
                if self._slots[slot_id].get("desired") != "stopped":
                    self._slots[slot_id].update(desired="stopped", updatedAt=_now())
        if self._slots:
            self._save_registry()

    def join_background(self, timeout: float | None = None) -> None:
        with self._lock:
            threads = list(self._threads)
        for thread in threads:
            thread.join(timeout)


# ── HTTP ────────────────────────────────────────────────────────────────────

_SLOT_PATH = re.compile(r"^/slots/([^/]+)$")
_STOP_PATH = re.compile(r"^/slots/([^/]+)/stop$")


def make_handler(supervisor: Supervisor):
    class Handler(BaseHTTPRequestHandler):
        server_version = "litco-supervisor"
        sys_version = ""
        protocol_version = "HTTP/1.1"

        def log_message(self, format, *args):
            # Method, path and status only; no header or body is ever logged.
            supervisor.log(f"{self.address_string()} {format % args}")

        def _send(self, status: int, payload: dict) -> None:
            data = (json.dumps(payload, sort_keys=True) + "\n").encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            # One request per connection: an unread body can never be parsed as the next request.
            self.send_header("Connection", "close")
            self.close_connection = True
            self.end_headers()
            self.wfile.write(data)

        def _error(self, exc: SupervisorError) -> None:
            self._send(exc.status, {"error": exc.code, "message": exc.message})

        def _authorized(self) -> bool:
            header = self.headers.get("Authorization", "")
            scheme, _, token = header.partition(" ")
            if scheme.lower() != "bearer" or not token:
                return False
            return hmac.compare_digest(token.strip().encode("utf-8"),
                                       supervisor.config.secret.encode("utf-8"))

        def _read_json(self):
            length = self.headers.get("Content-Length")
            if length is None or not length.isdigit():
                raise SupervisorError(411, "length_required", "Content-Length is required")
            if int(length) > MAX_BODY:
                raise SupervisorError(413, "body_too_large", f"body exceeds {MAX_BODY} bytes")
            raw = self.rfile.read(int(length))
            try:
                return json.loads(raw.decode("utf-8"))
            except (UnicodeDecodeError, ValueError) as exc:
                raise SupervisorError(400, "invalid_json", "body is not JSON") from exc

        def _drain_body(self) -> None:
            length = self.headers.get("Content-Length")
            if length and length.isdigit() and 0 < int(length) <= MAX_BODY:
                self.rfile.read(int(length))

        def _dispatch(self, method: str) -> None:
            path = self.path.split("?", 1)[0]
            try:
                if path == "/health":
                    if method != "GET":
                        raise SupervisorError(405, "method_not_allowed", "use GET")
                    self._send(200, supervisor.health())
                    return
                if not self._authorized():
                    self._drain_body()
                    raise SupervisorError(401, "unauthorized", "supervisor bearer token required")
                if path == "/slots":
                    if method != "GET":
                        raise SupervisorError(405, "method_not_allowed", "use GET")
                    self._send(200, supervisor.list_slots())
                    return
                match = _STOP_PATH.match(path)
                if match:
                    if method != "POST":
                        raise SupervisorError(405, "method_not_allowed", "use POST")
                    self._drain_body()
                    self._send(*supervisor.stop_slot(match.group(1)))
                    return
                match = _SLOT_PATH.match(path)
                if match:
                    if method != "PUT":
                        raise SupervisorError(405, "method_not_allowed", "use PUT")
                    self._send(*supervisor.put_slot(match.group(1), self._read_json()))
                    return
                raise SupervisorError(404, "not_found", "no such route")
            except SupervisorError as exc:
                self._error(exc)
            except Exception as exc:  # never let a traceback carry request data to the client
                supervisor.log(f"internal error on {method} {path}: {type(exc).__name__}")
                self._error(SupervisorError(500, "internal_error", "internal error"))

        def do_GET(self):
            self._dispatch("GET")

        def do_PUT(self):
            self._dispatch("PUT")

        def do_POST(self):
            self._dispatch("POST")

        def do_DELETE(self):
            self._dispatch("DELETE")

    return Handler


def bind_to_device(sock, interface: str) -> None:
    """Accept connections only from one interface (tailscale0). Linux, root only."""
    option = getattr(socket, "SO_BINDTODEVICE", 25)
    sock.setsockopt(socket.SOL_SOCKET, option, interface.encode("ascii") + b"\0")


class SupervisorServer(ThreadingHTTPServer):
    daemon_threads = True
    interface = ""

    def server_bind(self):
        if self.interface:
            bind_to_device(self.socket, self.interface)
        super().server_bind()


def make_server(config: Config, supervisor: Supervisor) -> SupervisorServer:
    class _Server(SupervisorServer):
        interface = config.interface

    return _Server((config.bind, config.port), make_handler(supervisor))


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--env-file", type=Path, default=Path(DEFAULT_ENV_FILE))
    args = parser.parse_args(argv)
    if os.geteuid() != 0:
        print("litco-supervisor: must run as root", file=sys.stderr)
        return 1
    os.umask(0o077)
    try:
        config = load_config(args.env_file)
        config.run_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        config.state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        supervisor = Supervisor(config)
        server = make_server(config, supervisor)
    except (ConfigError, OSError, ValueError) as exc:
        print(f"litco-supervisor: {exc}", file=sys.stderr)
        return 78  # EX_CONFIG
    where = f"{config.bind}:{config.port}" + (f" on {config.interface}" if config.interface else "")
    supervisor.log(f"listening on {where}; {len(supervisor._slots)} slot(s) registered")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
