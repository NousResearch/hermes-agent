#!/command/with-contenv /bin/sh
# shellcheck shell=sh
# Unprivileged supervision tree for per-profile gateways.
#
# Gateway slots are created at runtime by the hermes user (profile
# create/delete hooks, `hermes gateway start`, boot reconciliation), so
# their run/finish/log scripts are hermes-writable. They therefore must
# not sit in the root scandir (/run/service), where a root s6-supervise
# would execute them. Instead this service runs a nested s6-svscan AS
# HERMES over its own scandir; every s6-supervise it spawns, and every
# gateway it supervises, runs as hermes.
#
# The scandir is created hermes-owned by cont-init.d/02-reconcile-profiles,
# which also publishes the slots restored from the data volume, before
# s6-rc starts this service. Keep the path in sync with
# hermes_cli/service_manager.py::S6_DYNAMIC_SCANDIR.

scandir=/run/hermes-service

# Runs as root: resolve commands from system directories only. The gateway
# tree gets the inherited PATH (plus the hermes user's ~/.local/bin, appended)
# after the drop.
hermes_path="${PATH:-/opt/hermes/bin:/opt/hermes/.venv/bin:/usr/local/bin:/usr/bin:/bin}"
case ":$hermes_path:" in
    *:/opt/data/.local/bin:*) ;;
    *) hermes_path="$hermes_path:/opt/data/.local/bin" ;;
esac
PATH=/command:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# Skip the drop when already non-root (setgroups() lacks CAP_SETGID).
[ "$(/usr/bin/id -u)" = 0 ] || exec /usr/bin/env PATH="$hermes_path" /command/s6-svscan "$scandir"
exec /command/s6-setuidgid hermes /usr/bin/env PATH="$hermes_path" /command/s6-svscan "$scandir"
