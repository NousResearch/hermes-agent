{
  "fixtureVersion": 1,
  "name": "secret-literal-rejected",
  "description": "Proves secret: A literal string or number under a secret-shaped key is refused at every level, including inside mappings and lists; ${env:X} is not a placeholder.",
  "levels": [
    {
      "kind": "global",
      "values": {
        "model": {
          "provider": "nous"
        }
      },
      "locks": []
    },
    {
      "kind": "tenant",
      "values": {},
      "locks": []
    },
    {
      "kind": "principal",
      "values": {},
      "locks": []
    },
    {
      "kind": "agent",
      "values": {},
      "locks": []
    },
    {
      "kind": "profile",
      "values": {},
      "locks": []
    }
  ],
  "expect": {
    "effective": {
      "model": {
        "provider": "nous"
      }
    },
    "provenance": {
      "model.provider": "global"
    },
    "locks": []
  },
  "writes": [
    {
      "by": "profile",
      "op": "set",
      "path": "model.api_key",
      "value": "literal-value-1",
      "expect": {
        "result": "reject",
        "error": "config_secret_literal"
      }
    },
    {
      "by": "tenant",
      "op": "set",
      "path": "mcp_servers.github.env.GITHUB_TOKEN",
      "value": "literal-value-2",
      "expect": {
        "result": "reject",
        "error": "config_secret_literal"
      }
    },
    {
      "by": "agent",
      "op": "set",
      "path": "fallback_providers",
      "value": [
        {
          "provider": "openrouter",
          "api_key": "literal-value-3"
        }
      ],
      "expect": {
        "result": "reject",
        "error": "config_secret_literal"
      }
    },
    {
      "by": "principal",
      "op": "set",
      "path": "dashboard.basic_auth.password",
      "value": 1234,
      "expect": {
        "result": "reject",
        "error": "config_secret_literal"
      }
    },
    {
      "by": "profile",
      "op": "set",
      "path": "model",
      "value": {
        "api_key": "literal-value-4"
      },
      "expect": {
        "result": "reject",
        "error": "config_secret_literal"
      }
    },
    {
      "by": "profile",
      "op": "set",
      "path": "delegation.api_key",
      "value": "${env:X}",
      "expect": {
        "result": "reject",
        "error": "config_secret_literal"
      }
    }
  ]
}
