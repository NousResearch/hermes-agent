{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "score_report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "candidate_id",
    "split",
    "outcome",
    "passed",
    "score",
    "tokens",
    "steps",
    "time_seconds",
    "failure_reason",
    "trajectory_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "heldout"
      ]
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "error",
        "timeout"
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "tokens": {
      "type": "integer",
      "minimum": 0
    },
    "steps": {
      "type": "integer",
      "minimum": 0
    },
    "time_seconds": {
      "type": "number",
      "minimum": 0.0
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "trajectory_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "passed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "passed"
          },
          "failure_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "failed",
              "error",
              "timeout"
            ]
          },
          "failure_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
