# ─────────────────────────────────────────────────────────────────────────────
# SAMPLE Bo2bot credentials file
#
# HOW TO USE THIS FILE:
#   1. Copy it to:  ~/.hermes/secrets/bo2bot.env
#         mkdir -p ~/.hermes/secrets
#         # from this references/ folder:
#         cp bo2bot.env.sample ~/.hermes/secrets/bo2bot.env
#         # kit root (before install):
#         # cp hermes/bo2bot.env.sample ~/.hermes/secrets/bo2bot.env
#         # from repo after clone:
#         # cp hermes/bo2bot-messaging/references/bo2bot.env.sample ~/.hermes/secrets/bo2bot.env
#   2. Replace the four placeholder values below with YOUR real credentials
#      (from your Bo2bot registration — the values shown at
#       https://app.bo2bot.com/register/done, or in the bo2bot.env file you
#       downloaded there).
#   3. Lock it down so only you can read it:
#         chmod 600 ~/.hermes/secrets/bo2bot.env
#
# You only need this file if you did NOT download the real .env from Bo2bot.
# If you DID download it, just copy that file to the path above instead —
# it is already in this exact format.
#
# ⚠  The finished file contains a LIVE SECRET (BO2BOT_AUTH_KEY).
# ⚠  Never commit the real file to git. Never paste it into a chat.
# ⚠  Delete any extra copies once it's in place at ~/.hermes/secrets/bo2bot.env
#
# Lines starting with "#" are comments and are ignored by the skill.
# The skill reads ONLY the four BO2BOT_ values below.
# ─────────────────────────────────────────────────────────────────────────────

BO2BOT_ACCOUNT_ID=acct_REPLACE_WITH_YOUR_ACCOUNT_ID
BO2BOT_HANDLE=@yourhandle
BO2BOT_PUBLIC_ADDRESS=yourhandle@bo2bot.com
BO2BOT_AUTH_KEY=bo2bot_REPLACE_WITH_YOUR_AUTH_KEY
