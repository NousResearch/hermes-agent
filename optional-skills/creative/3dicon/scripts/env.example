# icon-loop — copy to .env and fill in what you plan to use.
# Nothing here is ever printed by the tool; keys are read and passed straight
# to the provider.

# --- Image generation: pick ONE backend ------------------------------------
# openai     — GPT Image (the newest gpt-image-* on your account is resolved
#              at runtime, so you do not pin a version that may not exist).
# gemini     — Gemini "Nano Banana" image models.
# openrouter — one key for both, via the unified Image API. Useful if you
#              already route everything through OpenRouter, or if you do not
#              hold a direct OpenAI/Google key.
ICONLOOP_IMAGE_BACKEND=openai

OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional override. Leave blank to auto-resolve the newest available model.
# openai     e.g. gpt-image-2.5-sunburst
# gemini     e.g. gemini-3-pro-image
# openrouter — resolved from its catalogue too; set this only to pin one
ICONLOOP_IMAGE_MODEL=

# --- Animation --------------------------------------------------------------
# Default. Image-to-video runs through OpenRouter, which reuses the
# OPENROUTER_API_KEY above — so one key can cover the still and the motion.
ICONLOOP_VIDEO_BACKEND=openrouter
ICONLOOP_VIDEO_MODEL=bytedance/seedance-2.0

# Other models there that take a first AND last frame, which the loop needs:
#   bytedance/seedance-2.5, google/veo-3.1, minimax/hailuo-3, alibaba/wan-2.7
# The Kling 3.0 models also qualify but cap prompts at 2500 characters, which
# the composed motion clause exceeds — they reject rather than truncate.

# Fallback backend: Replicate. Only needed for --via replicate, and note its
# Kling account stops at 2.5 — 2.6 and 3.0 are not published there.
REPLICATE_API_TOKEN=
ICONLOOP_KLING_MODEL=kwaivgi/kling-v2.5-turbo-pro
