    "name": { "type": "string" },
    "physical_operation": { "type": "string" },
    "narrative_operation": { "type": "string" },
    "character_operation": { "type": "string" },
    "relationship_operation": { "type": "string" },
    "visual_form": { "type": "array", "items": { "type": "string" } },
    "blocking": { "type": "array", "items": { "type": "string" } },
    "shot_structure": { "type": "array", "items": { "type": "string" } },
    "editing": { "type": "array", "items": { "type": "string" } },
    "sound": { "type": "array", "items": { "type": "string" } },
    "failure_mode": { "type": "string" },
    "inversion": { "type": "string" }
  }
}
