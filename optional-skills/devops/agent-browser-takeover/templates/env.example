# Copy to ~/.hermes/takeover/env and fill in. Never commit a filled copy.
# BIND_IP = this VPS WireGuard address (wg0). Never 0.0.0.0.

WG_IFACE=wg0
BIND_IP=
DISPLAY_NUM=98
VNC_PORT=5900
NOVNC_PORT=6080
HERMES_BROWSER_WS=ws://127.0.0.1:9377/camoufox
HERMES_HOLD_URL=https://example.com/

# Optional: browser public egress via another WireGuard peer (home NAS,
# travel router, second box). Leave empty to use the VPS WAN.
# Run scripts/wg_socks5.py on that peer, bound to PEER_WG_IP:1080.
# HERMES_BROWSER_PROXY=socks5://PEER_WG_IP:1080
HERMES_BROWSER_PROXY=
PEER_WG_IP=
SOCKS_PORT=1080
