# Fake lab mesh — copy to ~/.hermes/takeover/env and replace with yours.
# See references/topology.md

WG_IFACE=wg0
BIND_IP=10.13.37.1
DISPLAY_NUM=98
VNC_PORT=5900
NOVNC_PORT=6080
HERMES_BROWSER_WS=ws://127.0.0.1:9377/camoufox
HERMES_HOLD_URL=https://example.com/

# Optional peer origin (NAS-shaped). Leave empty for VPS WAN.
HERMES_BROWSER_PROXY=socks5://10.13.37.4:1080
PEER_WG_IP=10.13.37.4
SOCKS_PORT=1080
