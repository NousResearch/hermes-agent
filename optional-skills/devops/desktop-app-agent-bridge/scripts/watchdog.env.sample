# watchdog.env — settings for scripts/watchdog.sh and scripts/install-watchdog.sh
# Copy to ~/.hermes/agent-bridge-watchdog/watchdog.env and edit. Both scripts source this file.
# Nothing here is a secret, but the alert command reaches your messenger — keep it 600.

# ── the app ────────────────────────────────────────────────────────────────────
APP_NAME="MyApp"
APP_BUNDLE="/Applications/MyApp.app"
ASAR="$APP_BUNDLE/Contents/Resources/app.asar"
APP_SUPPORT="$HOME/Library/Application Support/MyApp"
# key in the bundle's agent-id -> binary map that identifies the agent we intercept
AGENT_ID_KEY="hermes-acp"
# the identifier in the bundle that sits next to the argv the app passes (blank = skip argv check)
ARGV_IDENTIFIER="localHermesAgent"
EXPECTED_BINARY="hermes hermes-acp"
EXPECTED_ARGV="acp"
# a bundled runtime matching this name would bypass the bridge entirely
BUNDLED_RUNTIME_PATTERN="*hermes*"

# ── our launchers (name in ~/.local/bin : template file in the guard dir) ──────
LAUNCHERS="hermes:hermes.bridge hermes-acp:hermes-acp.bridge"
# a template is considered installed if the target file contains this marker
BRIDGE_MARKER="__REMOTE_HOST__"

# ── the app's MCP wrapper, and the tools the workflow needs ────────────────────
APP_MCP_WRAPPER="$APP_SUPPORT/myapp-mcp"
REQUIRED_TOOLS="get_active_project read_project read_script apply_script"

# ── the remote side ────────────────────────────────────────────────────────────
REMOTE_HOST="my-server"
REMOTE_PROFILE_FILE="/home/you/.hermes/profiles/appwork/config.yaml"

# ── alerting: where the user actually looks ────────────────────────────────────
# Absolute path on the REMOTE host: a non-interactive ssh shell has no ~/.local/bin on PATH.
# Name the channel explicitly: a channel-less send fails with "no home channel set".
ALERT_CMD="/home/you/.local/bin/hermes"
ALERT_TARGET="matrix:!roomid:server"
