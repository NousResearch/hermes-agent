{
  "name": "hermes-agent",
  "version": "1.0.0",
  "description": "An AI agent with advanced tool-calling capabilities, featuring a flexible toolsets system for organizing and managing tools.",
  "private": true,
  "scripts": {
    "preinstall": "node -e \"if(!/^pnpm\\//.test(process.env.npm_config_user_agent||'')){console.error('This repository installs with pnpm: run pnpm install --frozen-lockfile');process.exit(1)}\"",
    "postinstall": "echo '✅ Node dependencies installed. Run: python run_agent.py --help'",
    "install:root": "pnpm install --filter .",
    "install:web": "pnpm install --filter web...",
    "install:tui": "pnpm install --filter hermes-tui...",
    "install:desktop": "pnpm install --filter hermes...",
    "audit:root": "pnpm audit --filter .",
    "audit:web": "pnpm audit --filter web",
    "audit:tui": "pnpm audit --filter hermes-tui",
    "audit:fix:root": "pnpm audit --fix --filter .",
    "audit:fix:web": "pnpm audit --fix --filter web",
    "audit:fix:tui": "pnpm audit --fix --filter hermes-tui",
    "check": "pnpm -r check",
    "fix": "pnpm -r fix",
    "prepare": "node -e \"const {existsSync}=require('fs');const {spawnSync}=require('child_process');if(existsSync('.git'))spawnSync('lefthook',['install'],{stdio:'inherit',shell:true})\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NousResearch/Hermes-Agent.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NousResearch/Hermes-Agent/issues"
  },
  "homepage": "https://github.com/NousResearch/Hermes-Agent#readme",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "10.12.0",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "lefthook": "2.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "js-yaml": "4.3.2",
    "semver": "7.7.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
