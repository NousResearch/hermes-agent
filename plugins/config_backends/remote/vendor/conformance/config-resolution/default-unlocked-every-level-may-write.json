      "value": 1,
      "expect": {
        "result": "accept"
      }
    },
    {
      "by": "group",
      "op": "unset",
      "path": "x",
      "expect": {
        "result": "accept"
      }
    },
    {
      "by": "principal",
      "op": "lock",
      "path": "x",
      "expect": {
        "result": "accept"
      }
    },
    {
      "by": "agent",
      "op": "unlock",
      "path": "x",
      "expect": {
        "result": "accept"
      }
    },
    {
      "by": "profile",
      "op": "set",
      "path": "x.y",
      "value": 2,
      "expect": {
        "result": "accept"
      }
    },
    {
      "by": "profile",
      "op": "unset",
      "path": "x.y",
      "expect": {
        "result": "accept"
      }
    }
  ]
}
