      "locks": []
    },
    {
      "kind": "tenant",
      "values": {},
      "locks": [
        "model.default"
      ]
    },
    {
      "kind": "principal",
      "values": {},
      "locks": []
    },
    {
      "kind": "agent",
      "values": {
        "model": {
          "default": "hermes-4-8b",
          "provider": "nous"
        }
      },
      "locks": []
    },
    {
      "kind": "profile",
      "values": {},
      "locks": []
    }
  ],
  "expect": {
    "effective": {
      "model": {
        "default": "hermes-4-405b",
        "provider": "nous"
      }
    },
