{
  "name": "@hermes-agent/photon-sidecar",
  "private": true,
  "version": "0.5.0",
  "description": "Spectrum-ts bridge for the Hermes Agent Photon platform plugin.",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "start": "node index.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke:spectrum": "node --test test/spectrum-compat.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@spectrum-ts/core": "12.4.0",
    "@spectrum-ts/imessage-local": "12.4.0",
    "spectrum-ts": "12.4.0"
  },
  "overrides": {
    "protobufjs": "8.7.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/otlp-transformer": "0.221.0",
    "@opentelemetry/otlp-exporter-base": "0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0"
