# Copy to .env and fill local secrets. Do not commit .env.

# Required runtime URLs for SSH-tunnel access
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api

# Required secrets
JWT_SECRET=replace-with-openssl-rand-hex-32
DATABASE_URL=postgresql://postiz-user:postiz-password@postiz-postgres:5432/postiz-db-local
POSTIZ_DB_USER=postiz-user
POSTIZ_DB_PASSWORD=postiz-password
POSTIZ_DB_NAME=postiz-db-local

# Local HTTP tunnel mode. Do not use this for public HTTPS deployments.
NOT_SECURED=true
DISABLE_REGISTRATION=true

# Copilot disabled by patch-and-start.sh unless upstream routing support is proven.
DISABLE_MCP=true
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Social OAuth app credentials. Leave blank until each platform is configured.
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
