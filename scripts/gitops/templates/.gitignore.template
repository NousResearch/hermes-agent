# KENSEI GitOps — .gitignore for ~/.hermes
# Two-layer: (1) deny everything at top level, (2) allow curated paths,
# (3) deny runtime junk INSIDE curated paths.
# Generated by scripts/gitops/install.sh — do not hand-edit in ~/.hermes.

# --- 1. Default-deny at top level ---
/*

# --- 2. Curated paths (whitelist) ---
!/config.yaml
!/profiles
!/profiles/**
!/cron
!/cron/**
!/governance
!/governance/**
!/scripts
!/scripts/**
!/skills
!/skills/**
!/runbooks
!/runbooks/**
!/feature-artifacts
!/feature-artifacts/**

# --- 3. Internal runtime junk inside curated paths ---
# Python
**/__pycache__/
**/*.pyc
**/*.pyo
# Lock files
**/*.lock
# Databases / SQLite
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
# Tmp / scratch
**/*.tmp
# Backup / superseded (cron jobs.json.bak-*, SKILL.md.bak, .sqlite.superseded-*)
**/*.bak
**/*.bak-*
**/*.superseded-*
# Logs
**/*.log
# Cron outputs (the JSON config is what we track, the output dir is junk)
cron/output/
# Cron runtime metadata: jobs.json mutates on every scheduler tick
# (last_run_at, next_run_at, repeat.completed, updated_at). The job
# definitions are tracked via the curated allowlist; runtime state is not.
cron/jobs.json
# Feature-artifacts: only .md files tracked; deny everything else inside.
feature-artifacts/**
!feature-artifacts/**/*.md
# Auth / credential temp files and backups (defence-in-depth).
**/auth.json.*
**/auth.tmp.*
**/credentials.json.*
**/credentials.tmp.*
# Vault keys and private keys.
**/vault.key
**/*.pem
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*

# --- 4. Always allow these, regardless of position ---
!.gitignore
!.gitignore.bak
!.gitkeep
