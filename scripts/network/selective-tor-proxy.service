[Unit]
Description=Selective Tor Proxy — routes opencode.ai through Tor, everything else direct
After=network.target tor@default.service
Wants=tor@default.service

[Service]
Type=simple
User=kensei
ExecStart=/usr/bin/python3 /home/kensei/.hermes/scripts/selective-tor-proxy.py
Restart=always
RestartSec=5
NoNewPrivileges=true
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
