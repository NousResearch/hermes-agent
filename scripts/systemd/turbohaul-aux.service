Wants=network.target

[Service]
Type=simple
User=kensei
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/home/sahil/ai/turbohaul-manager/vendor/turboquant-bin/llama-server \
    -m /home/sahil/ai/turbohaul-manager/models/Qwopus3.6-27B-v2-MTP-Q4_K_M.gguf \
