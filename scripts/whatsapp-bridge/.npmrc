# npm reads project config from the directory that owns the package.json, so this
# standalone package gets none of pnpm-workspace.yaml's minimumReleaseAge. The bridge
# holds WhatsApp session credentials, parses messages from arbitrary senders, and the
# gateway installs exactly this lockfile for every user (#134019): resolve it under the
# same 14-day cooldown as the workspace lockfile.
min-release-age=14
