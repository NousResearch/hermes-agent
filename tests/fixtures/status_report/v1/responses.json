{
  "interval_s": 120,
  "jitter": 0.1,
  "quick_retry_s": 5,
  "retry_after_max_s": 600,
  "rejected_backoff_s": [
    120,
    240,
    480,
    960,
    1920,
    3600,
    3600
  ],
  "goodbye_quiet_s": 60,
  "cases": [
    {
      "name": "stored",
      "status": 204,
      "headers": {},
      "outcome": "stored",
      "then": "next_interval"
    },
    {
      "name": "stored with a reply body",
      "status": 200,
      "headers": {},
      "body": {
        "interval_s": 1,
        "pause": true
      },
      "outcome": "stored",
      "then": "next_interval"
    },
    {
      "name": "throttled",
      "status": 429,
      "headers": {
        "Retry-After": "45"
      },
      "outcome": "throttled",
      "then": "wait",
      "wait_s": 45
    },
    {
      "name": "unavailable",
      "status": 503,
      "headers": {
        "Retry-After": "30"
      },
      "outcome": "throttled",
      "then": "wait",
      "wait_s": 30
    },
    {
      "name": "retry-after above the cap",
      "status": 503,
      "headers": {
        "Retry-After": "86400"
      },
      "outcome": "throttled",
      "then": "wait",
      "wait_s": 600
    },
    {
      "name": "throttled without retry-after",
      "status": 429,
      "headers": {},
      "outcome": "throttled",
      "then": "next_interval"
    },
    {
      "name": "retry-after that is not a number of seconds",
      "status": 503,
      "headers": {
        "Retry-After": "soon"
      },
      "outcome": "throttled",
      "then": "next_interval"
    },
    {
      "name": "retry-after of zero",
      "status": 429,
      "headers": {
        "Retry-After": "0"
      },
      "outcome": "throttled",
      "then": "next_interval"
    },
    {
      "name": "credential rejected",
      "status": 401,
      "headers": {},
      "outcome": "rejected",
      "then": "backoff"
    },
    {
      "name": "credential forbidden",
      "status": 403,
      "headers": {},
      "outcome": "rejected",
      "then": "backoff"
    },
    {
      "name": "server error",
      "status": 500,
      "headers": {},
      "outcome": "failed",
      "then": "quick_retry"
    },
    {
      "name": "bad gateway",
      "status": 502,
      "headers": {},
      "outcome": "failed",
      "then": "quick_retry"
    },
    {
      "name": "gateway timeout",
      "status": 504,
      "headers": {},
      "outcome": "failed",
      "then": "quick_retry"
    },
    {
      "name": "redirect",
      "status": 302,
      "headers": {
        "Location": "https://elsewhere.example/"
      },
      "outcome": "refused",
      "then": "next_interval"
    },
    {
      "name": "not found",
      "status": 404,
      "headers": {},
      "outcome": "refused",
      "then": "next_interval"
    },
    {
      "name": "payload refused",
      "status": 422,
      "headers": {},
      "outcome": "refused",
      "then": "next_interval"
    }
  ]
}
