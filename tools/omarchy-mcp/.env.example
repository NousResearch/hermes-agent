# Omarchy MCP Server — Environment Configuration
#
# Required:
#   OMARCHY_MCP_TOKEN    Bearer token for MCP auth (generate with openssl rand -hex 32)
#
# Optional:
#   PORT                 Server port (default: 8911)
#   BIND                 Bind address (default: 127.0.0.1 — loopback only)
#                        For LAN access set BIND=0.0.0.0 AND configure TLS
#   TLS_CERT             Path to TLS certificate file (for HTTPS)
#   TLS_KEY              Path to TLS key file (for HTTPS)
#   OMARCHY_USER_HOME    User home directory (default: ~ expansion)
#   OMARCHY_FILE_ROOTS   Colon-separated allowed paths for file tools
#                        (default: $OMARCHY_USER_HOME:/tmp)
#
# TLS setup (self-signed):
#   openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem \
#     -days 365 -nodes -subj '/CN=<your-vm-hostname>'

OMARCHY_MCP_TOKEN=changeme-use-openssl-rand-hex-32
PORT=8911
BIND=127.0.0.1
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem
# OMARCHY_USER_HOME=/home/myuser
# OMARCHY_FILE_ROOTS=/home/myuser:/tmp:/data