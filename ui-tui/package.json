{
  "name": "hermes-tui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:ink && tsx --watch src/entry.tsx",
    "start": "tsx src/entry.tsx",
    "build": "node ../scripts/build/tui.mjs",
    "i18n:keys": "tsx scripts/i18n-keys.ts",
    "i18n:keys:check": "tsx scripts/i18n-keys.ts --check",
    "build:ink": "pnpm --dir packages/hermes-ink run build",
    "visual": "node scripts/visual/run.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ packages/",
    "lint:fix": "eslint src/ packages/ --fix",
    "fmt": "prettier --write 'src/**/*.{ts,tsx}' 'packages/**/*.{ts,tsx}'",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "check": "pnpm run build:ink && pnpm run typecheck && pnpm run i18n:keys:check && pnpm run test && pnpm run lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hermes/ink": "workspace:*",
    "@hermes/shared": "workspace:*",
    "@nanostores/react": "1.1.0",
    "ink-text-input": "6.0.0",
    "nanostores": "1.4.2",
    "react": "19.3.0",
    "undici": "6.29.1",
    "unicode-animations": "1.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "chalk": "5.6.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "strip-ansi": "7.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
