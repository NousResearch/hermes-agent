engine-strict=true
min-release-age=14

# npm's release-age exclusion matches package names, not versions. These exceptions
# are needed for the exact patched versions in package.json and package-lock.json.
# Remove follow-redirects after 2026-11-08 21:33 UTC (GHSA-mrwp-f3q8-3g9p).
min-release-age-exclude[]=follow-redirects
# Remove joi after 2026-11-11 10:05 UTC (GHSA-4528-x5fx-h6hg).
min-release-age-exclude[]=joi
