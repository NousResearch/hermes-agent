# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

# 14-day supply-chain quarantine. Every min-release-age-exclude[] entry is a
# permanent hole in it, so each one must carry the release date of the version
# it exists to let through:
#
#   # <pkg> <ver> fixes <GHSA-...>. remove when > 2wks old (rel YYYY-MM-DD)
#   min-release-age-exclude[]=<pkg>
#
# Once that date is older than min-release-age the hole is inert and must be
# deleted; tests/test_npmrc_quarantine_expiry.py fails until it is.
min-release-age=14
