# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14

# 2026-10-14: security updates from Dependabot #117, younger than the 14-day gate.
# http-cache-semantics 4.3.0 (fixes GHSA-ch52-4w7c-c8xp) published 2026-10-04T02:56Z; remove after 2026-10-18T02:56Z.
min-release-age-exclude[]=http-cache-semantics
